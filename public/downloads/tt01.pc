TT 6589 "Menga otganing nima edi u?" VO__GUARD4__GENERIC__PATROL_HIT__M__4
TT 6590 "Yordam kerak! Kimdir meni o'qqa tutyapti!" VO__Guard4__GENERIC__PATROL_HIT_SEARCH__M__1
