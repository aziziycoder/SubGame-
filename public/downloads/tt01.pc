TT 10828 "VO__SOLDIER3__GENERIC__ONOM_SURPRISE_CATCH__M__3" VO__SOLDIER3__GENERIC__ONOM_SURPRISE_CATCH__M__3
TT 10829 "Yaxshi, bu o'yinlar yetar! Ularni toping!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH__M__1
TT 10830 "Hoy! Kimdir bela qidiryapti! Hamma joyni tintuv qilinglar!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH__M__2
TT 10831 "Bo'ldi, bu oxirgisi edi! Joyni qidiring!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH__M__3
TT 10832 "Yetar! Bu hazilkashlar jonimga tegdi! Ularni topinglar!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH__M__4
TT 10833 "Bo'ldi, bularning hammastidan to'yib ketdim! Sen o'lganga tengsan!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__1
TT 10834 "Meni ahmoq deb o'ylayapsanmi, a? Ko'ramiz..." VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__2
TT 10835 "Yetar! Bu sizlar uchun yaxshi tugamaydi!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__3
TT 10836 "Yetar! Boshqa o'yin bo'lmaydi, tushundingmi?!" VO__SOLDIER3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__4
TT 10837 "Bu yerga - hoziroq! Ular shu yerda!" VO__SOLDIER3__GENERIC__PATROL_ALERT__M__1
TT 10838 "Tezroq, bu yerga! Bir oz yordam kerak!" VO__SOLDIER3__GENERIC__PATROL_ALERT__M__2
TT 10839 "Bosqinchilar! Valuadan ba'zilari hali ham tirik ko'rinadi!" VO__SOLDIER3__GENERIC__PATROL_ALERT__M__3
TT 10840 "Ishonmayman... Ular bir nechta ekan! Tezroq!" VO__SOLDIER3__GENERIC__PATROL_ALERT__M__4
TT 10841 "Bolalar! Sizlarni kim yubordi? Kelinglar, salomlashing!" VO__SOLDIER3__GENERIC__PATROL_ALERT_ALONE__M__1
TT 10842 "Ah yo'q! Bu yerga hech qachon kelmasliging kerak edi..." VO__SOLDIER3__GENERIC__PATROL_ALERT_ALONE__M__2
TT 10843 "Qanday qilib... Bu yerdan tirik chiqib keta olmaysizlar..." VO__SOLDIER3__GENERIC__PATROL_ALERT_ALONE__M__3
TT 10844 "Josuslar! O'sha afsonaviy fransuz hiylagarligimi, a?" VO__SOLDIER3__GENERIC__PATROL_ALERT_ALONE__M__4
TT 10845 "Bo'ldi, ahmoqlik qilmang - yo'qoling!" VO__SOLDIER3__GENERIC__PATROL_ALERT_BLOCKED__M__1
TT 10846 "Ha, qora torting! Kalamushlardan oldin bo'rilar sizni yeydi!" VO__SOLDIER3__GENERIC__PATROL_ALERT_BLOCKED__M__2
TT 10847 "Agar men seni ushlamasam, boshqasi ushlaydi!" VO__SOLDIER3__GENERIC__PATROL_ALERT_BLOCKED__M__3
TT 10848 "Taslim bo'linglar! Bolalarga alohida e'tibor qilinadi!" VO__SOLDIER3__GENERIC__PATROL_ALERT_BLOCKED__M__4
TT 10849 "Qochadigan kuningiz tugadi!" VO__SOLDIER3__GENERIC__PATROL_CAPTURE__M__1
TT 10850 "Bu yerda hammasi tugaydi..." VO__SOLDIER3__GENERIC__PATROL_CAPTURE__M__2
TT 10851 "Ibotadingizni qilish vaqti keldi..." VO__SOLDIER3__GENERIC__PATROL_CAPTURE__M__3
TT 10852 "Buni qiyinlashtirmang endi. Hammasi tugadi!" VO__SOLDIER3__GENERIC__PATROL_CAPTURE__M__4
TT 10853 "Nima? Kim qildi buni? Menga javob ber! Jin ursin..." VO__SOLDIER3__GENERIC__PATROL_CORPSE__M__1
TT 10854 "Nima'? U hali chirishni boshlamabdi... Hozirgina sodir bo'lgan bo'lishi kerak..." VO__SOLDIER3__GENERIC__PATROL_CORPSE__M__2
TT 10855 "Nima balo... Senga nima bo'ldi, a?" VO__SOLDIER3__GENERIC__PATROL_CORPSE__M__3
TT 10856 "Hoy! Hoy, o'rtoq! Voy yo'q..." VO__SOLDIER3__GENERIC__PATROL_CORPSE__M__4
TT 10857 "Hey sen! O'rningdan tur! Yotib nima qilyapsan?" VO__SOLDIER3__GENERIC__PATROL_CORPSE_AFAR__M__1
TT 10858 "Endi-chi? Hoy! Get up!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_AFAR__M__2
TT 10859 "Bu to'g'ri emas! O'rningdan tur askar!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_AFAR__M__3
TT 10860 "Hey o'rtoq! Juda ko'p ichib yubordingmi yoki nima?" VO__SOLDIER3__GENERIC__PATROL_CORPSE_AFAR__M__4
TT 10861 "Jin ursin... Bir daqiqa siygani kirsang-u, keyingisida tiriklayin yeyilsang..." VO__SOLDIER3__GENERIC__PATROL_CORPSE_RATS__M__1
TT 10862 "Tentak... Ko'z tashlab turish shunchalik qiyinmi?" VO__SOLDIER3__GENERIC__PATROL_CORPSE_RATS__M__2
TT 10863 "Oh, la'nati! Shu ahvolda yeyilish. Sen askar emas, latifasan!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_RATS__M__3
TT 10864 "Oh Xudoyim... Yaxshi, diqqatingni jamla. Shunday tugatishni xohlamayman!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_RATS__M__4
TT 10865 "Askarlar! Atrofni qidiring - bu yerda jasad bor!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH__M__1
TT 10866 "Bizga kimdir o'q uzdi. Ular qayerdaligini toping!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH__M__2
TT 10867 "Bu atrofda qayerdadir qotil bor. Uni toping!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH__M__3
TT 10868 "Kimdir uning ishini bitiribdi! Iflos itni toping!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH__M__4
TT 10869 "U yerda kim bor? Og'riqni his qilishga tayyorlan..." VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__1
TT 10870 "Qayerdasan o'zi? Boshingni nayzaga sanchaman, eshityapsanmi?" VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__2
TT 10871 "Buni kim qildi u holda? Eshiting, nima olsam, shuni qaytaraman..." VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__3
TT 10872 "Qotil! Senga ham xuddi shunday qilaman!" VO__SOLDIER3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__4
TT 10873 "Argh! Yordam bering! Yordam bering!" VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS__M__1
TT 10874 "Jin ursin, yo'q! Yo'q, YO'Q!" VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS__M__2
TT 10875 "Xudoyim o'zing yordam ber! Iltimos!" VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS__M__3
TT 10876 "Oh ablah, meni bu yerdan olib chiqing!" VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS__M__4
TT 10877 "MENI HECH QACHON OLOLMAYSIZLAR! Iflos maxluqlar..." VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__1
TT 10878 "Seni ajablantirdimmi, a? Ha ha! O'zim ham biroz ajablandim..." VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__2
TT 10879 "Ooh! Undan o'tib oldim... va hali ham nafas olyapman!" VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__3
TT 10880 "Demak, yorug'likni ko'rasan va qochasan, a?" VO__SOLDIER3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__4
TT 10881 "Oo! Bu nima edi?" VO__SOLDIER3__GENERIC__PATROL_HIT__M__1
TT 10882 "Hoy! Bu nima balo? Qayerdasan, ablah?" VO__SOLDIER3__GENERIC__PATROL_HIT__M__2
