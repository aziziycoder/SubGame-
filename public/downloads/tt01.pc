TT 5817 "Juda kulgili..." VO__Guard2__CH7__RTC_ATTRACTED_012__M__1
TT 5818 "VO__GUARD2__CH7__RTC_ATTRACTED_ONOM_001__M__1" VO__GUARD2__CH7__RTC_ATTRACTED_ONOM_001__M__1
TT 5819 "Kim... Kimsan o'zi?" VO__GUARD2__CH9__CHATTER_BUDDY_GUARD_ALIVE_001__M__1
TT 5820 "Yo'q... Iltimos... Iltimos, rahm qiling..." VO__GUARD2__CH9__CHATTER_BUDDY_GUARD_ALIVE_003__M__1
TT 5821 "Isqirtlar... Nimalar... qilib qo'ydingiz?" VO__GUARD2__CH9__CHATTER_BUDDY_GUARD_KILLED_001__M__1
TT 5822 "Buning uchun to'laysiz..." VO__GUARD2__CH9__CHATTER_BUDDY_GUARD_KILLED_003__M__1
