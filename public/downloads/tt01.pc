TT 10115 "VO__SERVANT_F2__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__5" VO__SERVANT_F2__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__5
TT 10116 "Ha, u tunni shu yerda o'tkazdi. Kichkintoyning yana xuruji tutib qoldi." VO__SERVANT_F3__CH1__CHATTER_CROSSING_GABRIELLE_002__M__1
TT 10117 "Ehtiromimni qabul qiling, Amisiya." VO__SERVANT_F3__CH1__CHATTER_HELLO_GABRIELLE__M__1
TT 10118 "Hyugo! Bu men, Gabriella! Tezroq bu yoqqa kel!" VO__SERVANT_F3__CH1__CHATTER_QUESTION_1STSERVANT_000__M__1
TT 10119 "Unga tegma!" VO__SERVANT_F3__CH1__CHATTER_QUESTION_1STSERVANT_002__M__1
TT 10120 "Axir u yosh bolaku! Es-hushingizni yo'qotibsizlar..." VO__SERVANT_F3__CH1__CHATTER_QUESTION_1STSERVANT_004__M__1
TT 10121 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_FEAR__M__1" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_FEAR__M__1
TT 10122 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_KILL__M__1" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_KILL__M__1
TT 10123 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_KILL__M__2" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_KILL__M__2
TT 10124 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__1" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__1
TT 10125 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__2" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__2
TT 10126 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__3" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__3
TT 10127 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__4" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__4
TT 10128 "VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__5" VO__SERVANT_F3__GENERIC__ONOM_DEATH_BY_ENEMIES_PUNCH__M__5
TT 10129 "Ha... Kichkintoy gullarni yaxshi ko'radi. Men unga olib kelib turardim..." VO__SERVANT_M1__CH1__CHATTER_FLEEING_SERVANT_004__M__1
TT 10130 "Iltimos... Unday qilmang..." VO__SERVANT_M1__CH1__CHATTER_FLEEING_SERVANT_006__M__1
TT 10131 "Shafqat qiling! Shafqat qiling!" VO__SERVANT_M1__CH1__CHATTER_GRAPEVINES_001__M__1
TT 10132 "Xayrli kun, Ledi Amisiya!" VO__SERVANT_M1__CH1__CHATTER_HELLO_LAMBERT__M__1
TT 10133 "Ularni hali eplay olmadim..." VO__SERVANT_M1__CH1__CHATTER_JACQUES_LAMBERT_002__M__1
TT 10134 "Bu quyosh nuri uzoq davom etmaydi... Yomg'ir hosilni xarob qildi, odamlar ochlikdan o'lyapti... Shu uyda ekanligimizga shukur qilaylik, aytib qo'yay..." VO__SERVANT_M1__CH1__CHATTER_MEETING_BROOMGUY_001__M__1
TT 10135 "Bu borada haqlisan..." VO__SERVANT_M1__CH1__CHATTER_MEETING_BROOMGUY_002__M__1
TT 10136 "Ah! Tiriqsan! Bu tomonga!" VO__SERVANT_M1__CH1__CHATTER_REACH_EXIT__M__1
TT 10137 "VO__SERVANT_M1__CH1__ONOM_DEATH_LANCE__M__1" VO__SERVANT_M1__CH1__ONOM_DEATH_LANCE__M__1
TT 10138 "Bu tomonga. Ortimdan yur." VO__SERVANT_M1__CH1__RTC_SACRIFICE_001__M__1
TT 10139 "Xonim... Ular shu yerdalar!" VO__SERVANT_M1__CH1__RTC_SACRIFICE_009__M__1
TT 10140 "Biz qishloqni qayta qurishimiz mumkin, lekin baribir bo'sh uylar qoladi..." VO__SERVANT_M1__CH17__CHATTER_SMITH_001__M__1
TT 10141 "VO__SERVANT_M1__GENERIC__ONOM_AGONY_COUGH__M__1" VO__SERVANT_M1__GENERIC__ONOM_AGONY_COUGH__M__1
