TT 10149 "VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__1" VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__1
TT 10150 "VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__2" VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__2
TT 10151 "VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__3" VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__3
TT 10152 "VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__4" VO__SERVANT_M1__GENERIC__ONOM_EFFORT_LIGHT__M__4
TT 10153 "Butun umrim shu yerda ishladim... Ular men uchun oilamdek... Mendan hech narsa ololmaysan! Do'zaxga kating!" VO__SERVANT_M2__CH1__CHATTER_DYING_SERVANT_001__M__1
TT 10154 "Eshikni mustahkamlash uchun parchin mixlar qayerda?" VO__SERVANT_M2__CH1__CHATTER_JACQUES_LAMBERT_001__M__1
TT 10155 "Ingliz qo'shinlari yetib kelgani haqida eshitdingmi?... Erh..." VO__SERVANT_M2__CH1__CHATTER_JACQUES_LAMBERT_003__M__1
TT 10156 "U yangi parchin mixlar kutib turishi kerak... Aytgancha, shahardan xabar bormi?" VO__SERVANT_M2__CH1__CHATTER_JACQUES_LAMBERT_004__M__1
TT 10157 "Menga inglizlardek tuyulyapti..." VO__SERVANT_M2__CH1__CHATTER_JACQUES_LAMBERT_006__M__1
TT 10158 "Bilmadim, bizni muvozanatdan chiqarish uchun..." VO__SERVANT_M2__CH1__CHATTER_JACQUES_LAMBERT_008__M__1
TT 10159 "Bilsam ham, hech narsa aytmasdim! Ledi Beatris yaxshi inson!" VO__SERVANT_M2__CH1__CHATTER_KILLING_SERVANT_OPPOSE_002__M__1
TT 10160 "Hech qanday fikrim yo'q! Men faqat kirlarni yuvaman!" VO__SERVANT_M2__CH1__CHATTER_KILLING_SERVANTS_002__M__1
TT 10161 "Alia Oratio Sancti Sebastiani... Bizni yovuzlikdan asra... Bizga toabad sog'lik berib, vaboni eshigimizdan nari qil..." VO__SERVANT_M2__CH1__CHATTER_MEETING_PRAYING_MAN__M__1
TT 10162 "VO__SERVANT_M2__CH1__ONOM_DEATH_BEHEAD__M__1" VO__SERVANT_M2__CH1__ONOM_DEATH_BEHEAD__M__1
TT 10163 "Agar Tishlash bizni tinch qo'ysa, oxir-oqibat odamlar qaytib kelishadi..." VO__SERVANT_M2__CH17__CHATTER_SMITH_002__M__1
TT 10164 "VO__SERVANT_M2__GENERIC__ONOM_AGONY_COUGH__M__1" VO__SERVANT_M2__GENERIC__ONOM_AGONY_COUGH__M__1
