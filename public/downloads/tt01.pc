TT 2263 "Hmm... Shu zahoti jon beribdi..." VO__ALCHEMIST2__GENERIC__PATROL_CORPSE__M__2
TT 2264 "Yaxshimisiz? Janob?" VO__ALCHEMIST2__GENERIC__PATROL_CORPSE__M__3
TT 2265 "Hmm... Yuragi arang uryapti..." VO__ALCHEMIST2__GENERIC__PATROL_CORPSE__M__4
TT 2266 "U yerda nima qilyapti?" VO__ALCHEMIST2__GENERIC__PATROL_CORPSE_AFAR__M__1
TT 2267 "Bu jasadmi?" VO__ALCHEMIST2__GENERIC__PATROL_CORPSE_AFAR__M__2
