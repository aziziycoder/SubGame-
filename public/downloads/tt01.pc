TT 2968 "YO'Q! Yo'q!" VO__AMICIA__CH2__CHATTER_LADDER_FALL_001__M__1
TT 2969 "O'h yo'q, tezroq... Tezroq!" VO__AMICIA__CH2__CHATTER_LADY_WINDOW_002__M__1
