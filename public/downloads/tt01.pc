TT 5696 "Nima?" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER__M__8
TT 5697 "Bu qanday ovoz?" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__1
TT 5698 "Bu shovqin... Yaxshisi borib nimaligini ko'ray." VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__2
TT 5699 "Bu nima shovqin o'zi?" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__3
TT 5700 "Jinni emasman, nimadir eshitdim..." VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__4
TT 5701 "Hoy!" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__5
TT 5702 "Eh?" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__6
TT 5703 "Hm?" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__7
TT 5704 "Nima?" VO__GUARD1__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__8
TT 5705 "Bu nima edi? Yaqinroq borib ko'raman!" VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER__M__1
TT 5706 "Jin ursin... Yaxshilab qarab kelaylik!" VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER__M__2
TT 5707 "Borib qarab kelaman. Bu qora sehr yaxshilikka olib kelmaydi..." VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER__M__3
TT 5708 "Bu qanaqa sehr bo'ldi? Qani, bir ko'raylikchi..." VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER__M__4
TT 5709 "Jodu! Lekin buning ortida kim turibdi?..." VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER_ALONE__M__1
TT 5710 "Ishongim kelmayapti... Bu qanday qilib mumkin bo'lishi mumkin?" VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER_ALONE__M__2
TT 5711 "Bu nima o'zi? Jodugarlikmi?" VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER_ALONE__M__3
TT 5712 "Hech qachon bunaqasini ko'rmaganman... Bu nima edi?" VO__GUARD1__GENERIC__PATROL_SUSPICION_LIGHT_SPOTTER_ALONE__M__4
TT 5713 "Bu ular bo'lishi kerak... Borib ko'raman!" VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER__M__1
TT 5714 "Yana? Balki shular o'zidir! Qarab kelaman!" VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER__M__2
TT 5715 "Ular hamon o'sha yerdami? To'xta, men boraman!" VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER__M__3
TT 5716 "Buni kim qildi? Yana ularmi? Qarab kelaman!" VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER__M__4
TT 5717 "A? Yana ular! Shoshmay tur..." VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER_ALONE__M__1
TT 5718 "Yana? Agar shuni xohlayotgan bo'lsang... Boryapman..." VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER_ALONE__M__2
TT 5719 "Agar ular hali ham shu yerda bo'lsa... Men ularni topaman..." VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER_ALONE__M__3
TT 5720 "Aniq yana ular... Men ularga darsini berib qo'yaman..." VO__GUARD1__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER_ALONE__M__4
TT 5721 "Bu qamchi edimi? Bu nima edi? Borib ko'ramiz..." VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER__M__1
TT 5722 "Qars etgan ovoz eshitildimi? Qimirlamanglar!" VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER__M__2
TT 5723 "Palaxmonga o'xshadi-a? Hozir qaytaman!" VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER__M__3
TT 5724 "Men bu yoqqa ketyapman, qars etgan ovozni eshitdim!" VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER__M__4
TT 5725 "Bu qamchi edimi? Bu nima edi?" VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER_ALONE__M__1
TT 5726 "U yerda qarsillagan ovoz chiqdi-a?" VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER_ALONE__M__2
TT 5727 "G'alati, palaxmondek tuyuldi..." VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER_ALONE__M__3
TT 5728 "Anavi qarsillagan ovoz! Juda yaqin edi!" VO__GUARD1__GENERIC__PATROL_SUSPICION_SLING_SPOTTER_ALONE__M__4
TT 5729 "U yerda nimadir bor. Men borib ko'raman..." VO__Guard1__GENERIC__PATROL_SUSPICION_SPOTTER__M__1
TT 5730 "Ko'zimga ko'rindi shekilli... Hozir qaytaman." VO__GUARD1__GENERIC__PATROL_SUSPICION_SPOTTER__M__2
TT 5731 "Nimadir ko'rindi... Borib tekshirib kelaman." VO__GUARD1__GENERIC__PATROL_SUSPICION_SPOTTER__M__3
TT 5732 "Borib qarab kelaman..." VO__GUARD1__GENERIC__PATROL_SUSPICION_SPOTTER__M__4
TT 5733 "Anavi yerda! Bu nima o'zi..." VO__Guard1__GENERIC__PATROL_SUSPICION_SPOTTER_ALONE__M__1
TT 5734 "Anavi yerda nimadir qimirlaganini ko'rganimni bilaman..." VO__GUARD1__GENERIC__PATROL_SUSPICION_SPOTTER_ALONE__M__2
TT 5735 "U holda, bu nima edi?" VO__GUARD1__GENERIC__PATROL_SUSPICION_SPOTTER_ALONE__M__3
TT 5736 "Odamga o'xshaydi-a?" VO__GUARD1__GENERIC__PATROL_SUSPICION_SPOTTER_ALONE__M__4
