TT 2982 "Ular roppa-rosa orqamizda..." VO__AMICIA__CH2__CHATTER_PEOPLE_AROUND_007__M__1
TT 2983 "Tumor..." VO__AMICIA__CH2__CHATTER_PICKUP_GIFT_001__M__1
TT 2984 "Men ham. Kimdir uni tushirib qoldirgan bo'lsa kerak. Menimcha, uni olsak bo'ladi. Foydasi tegishi mumkin." VO__AMICIA__CH2__CHATTER_PICKUP_GIFT_003__M__1
