TT 3478 "Men kelayapman!" VO__AMICIA__CH5__CHATTER_BACK_IN_TOWN_002__M__1
TT 3479 "Shunchaki chetga burilish..." VO__AMICIA__CH5__CHATTER_BACK_TO_MELIE_002__M__1
TT 3480 "Meli! Bu yerda ozgina yordam kerak!" VO__AMICIA__CH5__CHATTER_BEFORE_DOOR_OPENING_001__M__1
TT 3481 "Xo'sh, mana shu yerda tushamiz!" VO__AMICIA__CH5__CHATTER_BOAT_AT_BAY_001__M__1
TT 3482 "Bilaman, lekin endi navbat boshqalarniki!" VO__AMICIA__CH5__CHATTER_BOAT_AT_BAY_003__M__1
TT 3483 "Meli! Men tashqi hududni tozalayapman! Ular sen tomonga borishmoqda!" VO__AMICIA__CH5__CHATTER_BRASERO_REMPART_001__M__1
TT 3484 "Xo'sh, biz butun hovlini tozalashimiz kerak!" VO__AMICIA__CH5__CHATTER_BRASERO_REMPART_003__M__1
TT 3485 "Meli! Yonimga kela olasanmi?" VO__AMICIA__CH5__CHATTER_CALLING_MELIE__M__1
TT 3486 "Inkvizitsiya aravasi!" VO__AMICIA__CH5__CHATTER_CART_REWARD_001__M__1
TT 3487 "Qanday qilib o'tib ketishimizni bilmayman..." VO__AMICIA__CH5__CHATTER_CART_REWARD_004__M__1
TT 3488 "Yaxshi..." VO__AMICIA__CH5__CHATTER_CART_REWARD_006__M__1
TT 3489 "Aql bovar qilmaydi..." VO__AMICIA__CH5__CHATTER_CASTLE_COURT_002__M__1
TT 3490 "Ha! Ajoyib!" VO__AMICIA__CH5__CHATTER_CLEAN_STATE_002__M__1
TT 3491 "Anavi yerdagi eshik! Iltimos, borib yopib kela olasanmi?" VO__AMICIA__CH5__CHATTER_CLOSE_THE_DOOR_001__M__1
TT 3492 "Hyugo? Nima qilyapsan? Bu yerga kel!" VO__AMICIA__CH5__CHATTER_CRISIS_1_002__M__1
TT 3493 "Meli, kutib tur..." VO__AMICIA__CH5__CHATTER_CRISIS_1_005__M__1
TT 3494 "Hyugo? Hyugo, menga qara... Yana boshlandimi? Boshingmi?" VO__AMICIA__CH5__CHATTER_CRISIS_2_001__M__1
TT 3495 "Bu Chaqish emas, bu... uning qonidagi narsa, kichkinaligidan beri bor... Men uni ko'tarib olishim kerak." VO__AMICIA__CH5__CHATTER_CRISIS_2_004__M__1
TT 3496 "Eplasang orqamga chiq. Qani." VO__AMICIA__CH5__CHATTER_CRISIS_3_001__M__1
TT 3497 "Xavotir olmang..." VO__AMICIA__CH5__CHATTER_CRISIS_3_003__M__1
TT 3498 "Yaxshiman... Lukas uning ta'sirini sekinlashtirishga harakat qilyapti. Qasrga borayotganimizning sababi ham shu." VO__AMICIA__CH5__CHATTER_CRISIS_3_005__M__1
TT 3499 "Nimaning Hyugo?" VO__AMICIA__CH5__CHATTER_CRISIS_3_007__M__1
TT 3500 "Hey, ana unga qara!" VO__AMICIA__CH5__CHATTER_DEFENSE_MECHANISM_001__M__1
TT 3501 "Ha! Bo'ldi!" VO__AMICIA__CH5__CHATTER_DONE_FOR_GOOD_001__M__1
TT 3502 "Oh ha! Yana boshqasi ham..." VO__AMICIA__CH5__CHATTER_DONE_FOR_GOOD_003__M__1
TT 3503 "Yopiq..." VO__AMICIA__CH5__CHATTER_DOOR_LOCKED_001__M__1
TT 3504 "Biz avval ularni o'tkazib olishimiz kerak!" VO__AMICIA__CH5__CHATTER_DOOR_LOCKED_003__M__1
TT 3505 "Bu bug'doyni yanchish uchun." VO__AMICIA__CH5__CHATTER_ENTERING_WATERMILL_002__M__1
TT 3506 "Nima? Lukas, aravada alkimyo materiallari to'la!" VO__AMICIA__CH5__CHATTER_EPIC_LOOT_003__M__1
TT 3507 "Lukas!" VO__AMICIA__CH5__CHATTER_EPIPHANY_002__M__1
TT 3508 "Foydali bo'lishi mumkin..." VO__AMICIA__CH5__CHATTER_EPIPHANY_010__M__1
TT 3509 "Ha, lekin qayerda?" VO__AMICIA__CH5__CHATTER_ESCAPE_003__M__1
TT 3510 "Ukang-chi?" VO__AMICIA__CH5__CHATTER_ESCAPE_005__M__1
TT 3511 "Kechirasiz..." VO__AMICIA__CH5__CHATTER_ESCAPE_007__M__1
TT 3512 "Ha Hyugo, kir." VO__AMICIA__CH5__CHATTER_FERRY_DOCKED_002__M__1
TT 3513 "Senga uzatdim!" VO__AMICIA__CH5__CHATTER_FERRY_DOCKED_REVERSE_001__M__1
TT 3514 "Ishonching komilmi?" VO__AMICIA__CH5__CHATTER_FERRY_FAIL_004__M__1
TT 3515 "Qani... Ombraj qasrining qamali - ikki qiz minglab kalamushlarga qarshi. Bu jang tarixda qoladi!" VO__AMICIA__CH5__CHATTER_FIRST_PUSH_001__M__1
TT 3516 "Ha... Bu yaxshi birinchi qadam." VO__AMICIA__CH5__CHATTER_FIRST_PUSH_003__M__1
TT 3517 "Katta rahmat..." VO__AMICIA__CH5__CHATTER_FIRST_PUSH_005__M__1
TT 3518 "Aytmoqchisanki, biroz nekbinlik kabi..." VO__AMICIA__CH5__CHATTER_FIRST_SLOWDOWN_003__M__1
TT 3519 "Yana nimadir bo'lishi kerak..." VO__AMICIA__CH5__CHATTER_FIRST_SLOWDOWN_AMICIA_003__M__1
TT 3520 "Xo'sh, Meli, yigitlar xayol surib turganda, biz yo'lda davom etishimiz kerak." VO__AMICIA__CH5__CHATTER_FIRST_THOUGHTS_004__M__1
TT 3521 "Buning nimaligini bilasanmi?" VO__AMICIA__CH5__CHATTER_FLOWER_INTERACT_001__M__1
TT 3522 "Voy-bo'y, bilimlar xazinasisan-ku!" VO__AMICIA__CH5__CHATTER_FLOWER_INTERACT_003__M__1
TT 3523 "Unda menga ham o'rgatasan." VO__AMICIA__CH5__CHATTER_FLOWER_INTERACT_005__M__1
TT 3524 "Kelishdik..." VO__AMICIA__CH5__CHATTER_FLOWER_INTERACT_007__M__1
TT 3525 "Panjara tushirilgan..." VO__AMICIA__CH5__CHATTER_GATES_NEAR_002__M__1
TT 3526 "Biz... shu yerdan... o'tamiz! Qani ketdik..." VO__AMICIA__CH5__CHATTER_GATEWAY_BREAK_001__M__1
TT 3527 "Eh? No..." VO__AMICIA__CH5__CHATTER_GATEWAY_BREAK_003__M__1
TT 3528 "Jinni bo'lma!" VO__AMICIA__CH5__CHATTER_GATEWAY_BREAK_005__M__1
TT 3529 "Yaxshi, men pastga tushyapman." VO__AMICIA__CH5__CHATTER_GIRLS_ABOVE_002__M__1
TT 3530 "Meli! Menga keraksan!" VO__AMICIA__CH5__CHATTER_GOOD_TO_GO_001__M__1
TT 3531 "Meli, men-..." VO__AMICIA__CH5__CHATTER_GUARDS_ABOUT_ARTHUR_005__M__1
TT 3532 "Biz narigi tomonga o'tishimiz kerak." VO__AMICIA__CH5__CHATTER_HALFWAY_CLEAR_002__M__1
TT 3533 "Yaxshi." VO__AMICIA__CH5__CHATTER_HALFWAY_CLEAR_004__M__1
