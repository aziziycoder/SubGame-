TT 6229 "VO__GUARD3__GENERIC__ONOM_SURPRISE_CATCH__M__3" VO__GUARD3__GENERIC__ONOM_SURPRISE_CATCH__M__3
TT 6230 "Hoy! Kimdir bela qidiryapti! Hamma joyni tintuv qilinglar!" VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH__M__1
TT 6231 "Bu atrofda g'irt ahmoqlar bor! Ko'zingizni ochib yuring!" VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH__M__2
TT 6232 "Bo'ldi, bu oxirgisi edi! Joyni qidiring!" VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH__M__3
TT 6233 "Yetar! Bu hazilkashlar jonimga tegdi! Ularni topinglar!" VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH__M__4
TT 6234 "Oh... Demak, kimdir balosiga o'zini uryapti, a? Bajonidil xizmat qilaman..." VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__1
TT 6235 "Yana nima bu? Jahlimgi chiqarmoqchimisan? Xo'sh, bunga muvaffaq bo'lding..." VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__2
TT 6236 "Yetar! Bu senga yaxshilik bilan tugamaydi!" VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__3
TT 6237 "Endi o'yin yo'q, kelishdikmi?!" VO__GUARD3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__4
TT 6238 "Bu yerda! Bostirib kirganlar!" VO__GUARD3__GENERIC__PATROL_ALERT__M__1
TT 6239 "Bu yerda kimdir bor! Ortga qayt!" VO__GUARD3__GENERIC__PATROL_ALERT__M__2
TT 6240 "Qani, hamma, bu yerda odamlar bor!" VO__GUARD3__GENERIC__PATROL_ALERT__M__3
TT 6241 "Ana, u yerda! Bosqinchilar! Tezroq!" VO__GUARD3__GENERIC__PATROL_ALERT__M__4
TT 6242 "Hey, sen! Men senga ozgina odobni o'rgatib qo'yaman..." VO__Guard3__GENERIC__PATROL_ALERT_ALONE__M__1
TT 6243 "Qimirlama, yaqinda hammasi tugaydi!" VO__GUARD3__GENERIC__PATROL_ALERT_ALONE__M__2
TT 6244 "Oh, seni qanday boplashimni ko'rasan hali, shoshmay tur!" VO__GUARD3__GENERIC__PATROL_ALERT_ALONE__M__3
TT 6245 "Oh! O'zingizni biroz yaxshiroq yashirishingiz kerak edi..." VO__GUARD3__GENERIC__PATROL_ALERT_ALONE__M__4
TT 6246 "Seni topaman!" VO__Guard3__GENERIC__PATROL_ALERT_BLOCKED__M__1
TT 6247 "Ishonchim komilki, bu sen uchun yomon tugaydi..." VO__GUARD3__GENERIC__PATROL_ALERT_BLOCKED__M__2
TT 6248 "Oxiri seni ushlayman..." VO__GUARD3__GENERIC__PATROL_ALERT_BLOCKED__M__3
TT 6249 "Bas qil, tushundingmi? Qayt!" VO__GUARD3__GENERIC__PATROL_ALERT_BLOCKED__M__4
TT 6250 "Shunchaki nafas ol... So'nggi marta." VO__Guard3__GENERIC__PATROL_CAPTURE__M__1
TT 6251 "Tinchlan bolakay! Endi hammasi tugadi!" VO__GUARD3__GENERIC__PATROL_CAPTURE__M__2
TT 6252 "Bo'ldi. Xayrlash... umrbod!" VO__GUARD3__GENERIC__PATROL_CAPTURE__M__3
TT 6253 "Seni hech kim sog'inmaydi, yaramas bola..." VO__GUARD3__GENERIC__PATROL_CAPTURE__M__4
TT 6254 "Qani, o'rningdan tur! O'rningdan tur!" VO__Guard3__GENERIC__PATROL_CORPSE__M__1
TT 6255 "Senga nima balo bo'ldi?" VO__GUARD3__GENERIC__PATROL_CORPSE__M__2
TT 6256 "U yaqin orada yana o'rnidan turishiga ko'zim yetmaydi..." VO__GUARD3__GENERIC__PATROL_CORPSE__M__3
TT 6257 "Hoy! Hammasi joyidami?" VO__GUARD3__GENERIC__PATROL_CORPSE__M__4
TT 6258 "Tur o'rningdan! Nega u o'rnidan turmayapti?" VO__Guard3__GENERIC__PATROL_CORPSE_AFAR__M__1
TT 6259 "Pastda nima qilyapman deb o'ylayapsan, a? Hoy?" VO__GUARD3__GENERIC__PATROL_CORPSE_AFAR__M__2
TT 6260 "Endi-chi?" VO__GUARD3__GENERIC__PATROL_CORPSE_AFAR__M__3
TT 6261 "Hoy. Bu yerda nima qilyapsan a?" VO__GUARD3__GENERIC__PATROL_CORPSE_AFAR__M__4
TT 6262 "Uf... Ehtiyotkorroq bo'lishing kerak edi..." VO__Guard3__GENERIC__PATROL_CORPSE_RATS__M__1
TT 6263 "O'zini ehtiyot qilolmagan yana bir ahmoq..." VO__GUARD3__GENERIC__PATROL_CORPSE_RATS__M__2
TT 6264 "Nima balo... Ichib olgan bo'lsa kerak, ahmoq isqirt." VO__GUARD3__GENERIC__PATROL_CORPSE_RATS__M__3
TT 6265 "Oh, bu badbo'y hid! U o'lganidan keyin ham bizni bezovta qilyapti!" VO__GUARD3__GENERIC__PATROL_CORPSE_RATS__M__4
TT 6266 "Ehtiyot bo'ling! Bizda ehtimol qurollangan bosqinchi bor!" VO__Guard3__GENERIC__PATROL_CORPSE_SEARCH__M__1
TT 6267 "Bu yerda odamimiz yiqilgan. Ko'zingizni oching!" VO__GUARD3__GENERIC__PATROL_CORPSE_SEARCH__M__2
TT 6268 "Bizda bitta murda bor! Qo'rqoq shu yaqinda bo'lishi kerak!" VO__GUARD3__GENERIC__PATROL_CORPSE_SEARCH__M__3
TT 6269 "Bizga hujum qilishmoqda! Ehtiyot bo'ling!" VO__GUARD3__GENERIC__PATROL_CORPSE_SEARCH__M__4
TT 6270 "Buni kim qilganini bilmayman, lekin ular tovon to'laydi!" VO__Guard3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__1
TT 6271 "Nega bunday qildingiz? Buning uchun kimdir tovon to'laydi!" VO__GUARD3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__2
TT 6272 "Unda buni kim qildi? Jazodan qutulib qololmassiz!" VO__GUARD3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__3
TT 6273 "Qayerga yashirinyapsan? Yaxshisi meni topolmasin deb duo qil..." VO__GUARD3__GENERIC__PATROL_CORPSE_SEARCH_ALONE__M__4
TT 6274 "Yo'q, nari ket! NARI KET!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS__M__1
TT 6275 "Jin ursin, faqat buni emas! BUNDAN BOSHQA HAR NARSAGA ROZIMAN!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS__M__2
TT 6276 "Xudoyim, menga yordam ber! HOZIROQ!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS__M__3
TT 6277 "Xudoyim, yo'q!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS__M__4
TT 6278 "Men sizlarning keyingi ovqatingiz bo'lmayman! Hozir emas, hech qachon!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__1
TT 6279 "Men tirikman! Men hali ham tirikman!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__2
TT 6280 "Epladim! Epladim! Ha ha!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__3
TT 6281 "HA! Qutulib qoldim!" VO__GUARD3__GENERIC__PATROL_FLEE_RATS_ESCAPE__M__4
TT 6282 "Nima? Bu nima edi?" VO__Guard3__GENERIC__PATROL_HIT__M__1
TT 6283 "Unda u nima edi?" VO__GUARD3__GENERIC__PATROL_HIT__M__2
TT 6284 "Qayerdan... U qayerdan keldi?" VO__GUARD3__GENERIC__PATROL_HIT__M__3
TT 6285 "Hoy! Bu nima edi?" VO__GUARD3__GENERIC__PATROL_HIT__M__4
TT 6286 "Atrofni qidiring! Kimdir bizga hujum qilyapti!" VO__Guard3__GENERIC__PATROL_HIT_SEARCH__M__1
TT 6287 "Yordam bering! Menga hujum qilishyapti!" VO__GUARD3__GENERIC__PATROL_HIT_SEARCH__M__2
TT 6288 "Bu yoqqa! Meni o'qqa tutishyapti!" VO__GUARD3__GENERIC__PATROL_HIT_SEARCH__M__3
TT 6289 "Kimdir menga o'q uzayapti... Ular uzoqda bo'lishi mumkin emas!" VO__GUARD3__GENERIC__PATROL_HIT_SEARCH__M__4
TT 6290 "Seni topgunimcha kutib tur!" VO__Guard3__GENERIC__PATROL_HIT_SEARCH_ALONE__M__1
TT 6291 "Sen kabi qo'rqoqlarni bu yerda nima qilishimizni senga ko'rsatib qo'yaman!" VO__GUARD3__GENERIC__PATROL_HIT_SEARCH_ALONE__M__2
TT 6292 "Seni topganimda haqiqiy azob qanday bo'lishini ko'rasan." VO__GUARD3__GENERIC__PATROL_HIT_SEARCH_ALONE__M__3
TT 6293 "Menimcha bu hikoyaning qanday tugashi senga yoqmaydi..." VO__GUARD3__GENERIC__PATROL_HIT_SEARCH_ALONE__M__4
TT 6294 "Ishongim kelmayapti! Hoy, qayt, QAYT!" VO__GUARD3__GENERIC__PATROL_MISS__M__1
TT 6295 "Nima bo'lyapti bu yerda? A?" VO__GUARD3__GENERIC__PATROL_MISS__M__2
TT 6296 "Shundaymi? Keling, o'ynaymiz unda!" VO__GUARD3__GENERIC__PATROL_MISS__M__3
TT 6297 "Eh?" VO__GUARD3__GENERIC__PATROL_REACTION__M__1
TT 6298 "Hm?" VO__GUARD3__GENERIC__PATROL_REACTION__M__2
TT 6299 "Nima?" VO__GUARD3__GENERIC__PATROL_REACTION__M__3
TT 6300 "Hoy!" VO__GUARD3__GENERIC__PATROL_REACTION__M__4
TT 6301 "Unut..." VO__GUARD3__GENERIC__PATROL_RESUME__M__1
TT 6302 "Mmmmh..." VO__GUARD3__GENERIC__PATROL_RESUME__M__2
TT 6303 "Qasamyod qilishim mumkinki..." VO__GUARD3__GENERIC__PATROL_RESUME__M__3
TT 6304 "Hech narsa..." VO__GUARD3__GENERIC__PATROL_RESUME__M__4
TT 6305 "Yana hech narsa yo'q... Yaxshi, soqovulingizga qayting!" VO__GUARD3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER__M__1
TT 6306 "Rostdan... Hamon bu yerda hech narsa yo'q... Hamma o'z joyiga!" VO__GUARD3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER__M__2
TT 6307 "Yana bir yolg'on xavotir... Joyingizga qayting!" VO__GUARD3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER__M__3
TT 6308 "Qaranglar, bu yerda hech narsa yo'q... YANA... Joylaringizga qaytinglar!" VO__GUARD3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER__M__4
TT 6309 "Hech narsa... Yana adashgan bo'lsam kerak..." VO__GUARD3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER_ALONE__M__1
TT 6310 "Tushunmayapman... Bu safar nimadir topishim kerak edi..." VO__GUARD3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER_ALONE__M__2
