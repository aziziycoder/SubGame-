TT 2507 "U shu tarafdan keldi!" VO__ALCHEMIST3__GENERIC__PATROL_HIT__M__4
TT 2508 "Men hujum ostidaman! Yordam!" VO__ALCHEMIST3__GENERIC__PATROL_HIT_SEARCH__M__1
