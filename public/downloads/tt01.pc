TT 10174 "VO__SERVANT_M2__GENERIC__ONOM_EFFORT_LIGHT__M__3" VO__SERVANT_M2__GENERIC__ONOM_EFFORT_LIGHT__M__3
TT 10175 "VO__SERVANT_M2__GENERIC__ONOM_EFFORT_LIGHT__M__4" VO__SERVANT_M2__GENERIC__ONOM_EFFORT_LIGHT__M__4
TT 10176 "Ifloslar... Qo'rqoqlar..." VO__SERVANT_M3__CH1__CHATTER_DYING_SERVANT_006__M__1
TT 10177 "Oh! Ledi Amisiya! Qaytib kelibsiz!" VO__SERVANT_M3__CH1__CHATTER_HELLO_THEO__M__1
TT 10178 "Hamma asabiy... Kechasi ba'zilar tishlandi..." VO__SERVANT_M3__CH1__CHATTER_JACQUES_LAMBERT_005__M__1
TT 10179 "Nega endi inglizlar borib odamlarni tishlashi kerak?" VO__SERVANT_M3__CH1__CHATTER_JACQUES_LAMBERT_007__M__1
TT 10180 "Mayli... Oh, aytgancha, otxonaning orqasida palahmoning uchun bir nechta nishonlar o'rnatdim!" VO__SERVANT_M3__CH1__CHATTER_TALK_TO_THEO_002__M__1
TT 10181 "VO__SERVANT_M3__GENERIC__ONOM_AGONY_COUGH__M__1" VO__SERVANT_M3__GENERIC__ONOM_AGONY_COUGH__M__1
