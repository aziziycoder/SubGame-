TT 2284 "Bu qayoqdan paydo bo'ldi?" VO__ALCHEMIST2__GENERIC__PATROL_HIT__M__3
TT 2285 "Nima? Nima! Bu qayerdan keldi?" VO__ALCHEMIST2__GENERIC__PATROL_HIT__M__4
TT 2286 "Men hujum ostidaman! Yordam!" VO__ALCHEMIST2__GENERIC__PATROL_HIT_SEARCH__M__1
TT 2287 "Menga yordam kerak, men hujum ostidaman!" VO__ALCHEMIST2__GENERIC__PATROL_HIT_SEARCH__M__2
