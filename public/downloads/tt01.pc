TT 4167 "Yugur!" VO__AMICIA__CH9__CHATTER_STRAW_RUSH_1_003__M__1
TT 4168 "Qani... qani..." VO__AMICIA__CH9__CHATTER_STRAW_RUSH_2_001__M__1
TT 4169 "Qani! Yugur!" VO__AMICIA__CH9__CHATTER_STRAW_RUSH_2_002__M__1
TT 4170 "Yordaming uchun rahmat!" VO__AMICIA__CH9__CHATTER_STRAW_RUSH_2_004__M__1
TT 4171 "Hammasi joyida..." VO__AMICIA__CH9__CHATTER_STRAW_RUSH_OK__M__1
TT 4172 "Voy!" VO__AMICIA__CH9__CHATTER_SUDDEN_RATS_001__M__1
TT 4173 "Oqqush... Mahobatli va nafis..." VO__AMICIA__CH9__CHATTER_SWAN_SYMBOL__M__1
TT 4174 "Lukas, shu... Onam o'lganini aynan shu yerda ko'rdim..." VO__AMICIA__CH9__CHATTER_THAT_DOOR_001__M__1
TT 4175 "Ha! Bu bechora Lambert! U zarbani onamning o'rniga o'ziga olgan bo'lsa kerak... U... U hali ham tirik... Lekin.. Lekin... Ular..." VO__AMICIA__CH9__CHATTER_THAT_DOOR_003__M__1
TT 4176 "Mening uyim..." VO__AMICIA__CH9__CHATTER_THE_ALLEY_002__M__1
TT 4177 "Yo'q... Yo'q iltimos..." VO__AMICIA__CH9__CHATTER_THE_ALLEY_004__M__1
TT 4178 "Yo'q. Men ko'rishim kerak." VO__AMICIA__CH9__CHATTER_THE_ALLEY_006__M__1
TT 4179 "Yaxshi!" VO__AMICIA__CH9__CHATTER_TOO_FAR_1_002__M__1
TT 4180 "Men qaytaman!" VO__AMICIA__CH9__CHATTER_TOO_FAR_2_002__M__1
TT 4181 "Oh, jin ursin..." VO__AMICIA__CH9__CHATTER_TOO_FAR_3_002__M__1
TT 4182 "Ha... Ha... Kelyapman" VO__AMICIA__CH9__CHATTER_TORCH_002__M__1
TT 4183 "Yiqilib tushma... Yiqilib tushma..." VO__AMICIA__CH9__CHATTER_WOODEN_BRIDGE_001__M__1
TT 4184 "Gul... Butun..." VO__AMICIA__CH9__HELPER_FLOWER_CLOSE_001__M__1
TT 4185 "Bitta ish bitdi..." VO__AMICIA__CH9__HELPER_LIGHT_BRASERO_OK__M__1
TT 4186 "U yerga yetib bora olmayman! Atrofda kalamushlar juda ko'p..." VO__AMICIA__CH9__HELPER_NEED_BRASERO_001__M__1
TT 4187 "I'm on it!" VO__AMICIA__CH9__HELPER_NEED_BRASERO_003__M__1
TT 4188 "VO__AMICIA__CH9__ONOM_HUGOS_ROOM_SURPRISE__M__1" VO__AMICIA__CH9__ONOM_HUGOS_ROOM_SURPRISE__M__1
TT 4189 "Lukas! Menda hech narsa qolmadi!" VO__AMICIA__CH9__RTC_DANGEROUS_001__M__1
TT 4190 "LUKAS!" VO__AMICIA__CH9__RTC_DANGEROUS_002__M__1
TT 4191 "Nima... nima bo'lyapti?" VO__AMICIA__CH9__RTC_DANGEROUS_003__M__1
TT 4192 "Xo'sh... Bu yerda aylanib yurmaylik." VO__AMICIA__CH9__RTC_DANGEROUS_005__M__1
TT 4193 "Lukas, sen uddalading..." VO__AMICIA__CH9__RTC_DANGEROUS_007__M__1
TT 4194 "Lavrentiy sen bilan faxrlangan bo'lardi... MEN sen bilan faxrlanaman." VO__AMICIA__CH9__RTC_DANGEROUS_009__M__1
TT 4195 "Ha, lekin avvalambor - Hyugoni qutqarishimiz kerak." VO__AMICIA__CH9__RTC_DANGEROUS_011__M__1
TT 4196 "Oh yo'q! Yo'q yo'q! Ular nima qilishyapti?" VO__AMICIA__CH9__RTC_DEAD_FATHER_005__M__1
TT 4197 "Orqaga qayt!" VO__AMICIA__CH9__RTC_DEAD_FATHER_006__M__1
TT 4198 "Hamma narsa... Hamma narsa oldingidek..." VO__AMICIA__CH9__RTC_HUGOS_ROOM_001__M__1
TT 4199 "Lukas, nega uning xonasiga tegilmagan?" VO__AMICIA__CH9__RTC_HUGOS_ROOM_004__M__1
TT 4200 "Hali ham o'xshamayaptimi?" VO__AMICIA__CH9__RTC_HUGOS_ROOM_006__M__1
TT 4201 "Men bilganlarim emas..." VO__AMICIA__CH9__RTC_HUGOS_ROOM_008__M__1
TT 4202 "Bilmayman... Qayerdaligini ko'rmayapman..." VO__AMICIA__CH9__RTC_HUGOS_ROOM_010__M__1
TT 4203 "U menga hech narsa demagandi! Men uni hech qachon ko'rmaganman!" VO__AMICIA__CH9__RTC_HUGOS_ROOM_012__M__1
TT 4204 "Xo'sh... Qadimgi Rim xarobalari... U mening u yerga borishimni xohlamasdi..." VO__AMICIA__CH9__RTC_HUGOS_ROOM_014__M__1
TT 4205 "Bog'! Ketdik!" VO__AMICIA__CH9__RTC_HUGOS_ROOM_016__M__1
TT 4206 "Lukas... Qara..." VO__AMICIA__CH9__RTC_THE_HAND_001__M__1
TT 4207 "Nima?" VO__AMICIA__CH9__RTC_THE_HAND_003__M__1
TT 4208 "Lukas!" VO__AMICIA__CH9__RTC_THE_HAND_003__M__2
TT 4209 "Aytib qol! Bu nima o'zi?" VO__AMICIA__CH9__RTC_THE_HAND_005__M__1
TT 4210 "Aytmoqchisanki... o'sha sen-" VO__AMICIA__CH9__RTC_THE_HAND_007__M__1
TT 4211 "Demak, biz undan o'zimiz ham foydalanishimiz mumkin!" VO__AMICIA__CH9__RTC_THE_HAND_009__M__1
TT 4212 "Sen buni yaxshi boshlaganga o'xshaysan... Magistr." VO__AMICIA__CH9__RTC_THE_HAND_011__M__1
TT 4213 "Nega u menga aytmadi? ... Men tushungan bo'lardim... Men..." VO__AMICIA__CH9__RTC_THE_HAND_012__M__1
TT 4214 "Unut! Shunchaki davoni tugat! Men ularni ushlab turaman!" VO__AMICIA__CH9__RTC_THE_HAND_015__M__1
TT 4215 "Biz shu yerdamiz..." VO__AMICIA__CH9__RTC_TRANSITION_001__M__1
TT 4216 "Ha... Bu shunchaki... qaytib kelish g'alati tuyulyapti. Ketdik." VO__AMICIA__CH9__RTC_TRANSITION_003__M__1
TT 4217 "O'yla, Amisiya... o'yla!" VO__AMICIA__CH10__CHATTER_1ST_CLUE__M__1
TT 4218 "Imkoning borida kulib qol..." VO__AMICIA__CH10__CHATTER_ARMING_SLING__M__1
