TT 11334 "VO__VILLAGER_M3__GENERIC__ONOM_HIT_STRONG__M__3" VO__VILLAGER_M3__GENERIC__ONOM_HIT_STRONG__M__3
TT 11335 "VO__VILLAGER_M3__GENERIC__ONOM_RAGE__M__1" VO__VILLAGER_M3__GENERIC__ONOM_RAGE__M__1
TT 11336 "VO__VILLAGER_M3__GENERIC__ONOM_RAGE__M__2" VO__VILLAGER_M3__GENERIC__ONOM_RAGE__M__2
TT 11337 "VO__VILLAGER_M3__GENERIC__ONOM_RAGE__M__3" VO__VILLAGER_M3__GENERIC__ONOM_RAGE__M__3
TT 11338 "Hoy... senga aytyapman, bu yerda o'zicha aqlli biri bor ekan... Qani ko'raylik-chi!" VO__VILLAGER_M3__GENERIC__PATROL_AGAIN_SEARCH__M__1
TT 11339 "Hoy! Bu atrofda bir nechta shumtakalar bor shekilli! Toping ularni!" VO__VILLAGER_M3__GENERIC__PATROL_AGAIN_SEARCH__M__2
TT 11340 "Shaytonliklaring yetar, eshityapsanmi?! Kelyapman!" VO__VILLAGER_M3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__1
TT 11341 "Bo'ldi, bularning hammastidan to'yib ketdim! Sen o'lganga tengsan!" VO__VILLAGER_M3__GENERIC__PATROL_AGAIN_SEARCH_ALONE__M__2
TT 11342 "Ular ana. Ushlanglar!" VO__VILLAGER_M3__GENERIC__PATROL_ALERT__M__1
TT 11343 "Bolalar! Ularni qochishiga yo'l qo'ymang!" VO__VILLAGER_M3__GENERIC__PATROL_ALERT__M__2
TT 11344 "Hoy! Bu yoqqa kel va o'l!" VO__VILLAGER_M3__GENERIC__PATROL_ALERT_ALONE__M__1
TT 11345 "Sen! Hissob-kitob qiladigan vaqting keldi!" VO__VILLAGER_M3__GENERIC__PATROL_ALERT_ALONE__M__2
TT 11346 "Bu yerga qaytinglar yaramas jinlar!" VO__VILLAGER_M3__GENERIC__PATROL_ALERT_BLOCKED__M__1
TT 11347 "Qochishni to'xtatadigan vaqt keldi, yaramas jin..." VO__VILLAGER_M3__GENERIC__PATROL_CAPTURE__M__1
TT 11348 "Oh! Bu qayerdan keldi-ya?" VO__VILLAGER_M3__GENERIC__PATROL_HIT__M__1
TT 11349 "Bu jin ursin nima edi?" VO__VILLAGER_M3__GENERIC__PATROL_HIT__M__2
TT 11350 "Menga bu yerda yordam kerak. Kimdir menga o'q uzyapti!" VO__VILLAGER_M3__GENERIC__PATROL_HIT_SEARCH__M__1
TT 11351 "Menga hujum qilishdi! Qo'rqoqlarni o'ldiring!" VO__VILLAGER_M3__GENERIC__PATROL_HIT_SEARCH__M__2
TT 11352 "Bu yerdan tirik chiqmaysan, jin!" VO__VILLAGER_M3__GENERIC__PATROL_HIT_SEARCH_ALONE__M__1
TT 11353 "Qayerdasan, iflos qo'rqoq?" VO__VILLAGER_M3__GENERIC__PATROL_HIT_SEARCH_ALONE__M__2
TT 11354 "Yo Xudoyim! Qarab tur!" VO__VILLAGER_M3__GENERIC__PATROL_MISS__M__1
TT 11355 "Shaytonlik! Parvardigor qilichimga yo'l ko'rsatsin!" VO__VILLAGER_M3__GENERIC__PATROL_MISS__M__2
TT 11356 "Jirkanch bolalar! Buning uchun tovon to'laysizlar!" VO__VILLAGER_M3__GENERIC__PATROL_MISS__M__3
TT 11357 "Eh?" VO__VILLAGER_M3__GENERIC__PATROL_REACTION__M__1
TT 11358 "Nima balo...?" VO__VILLAGER_M3__GENERIC__PATROL_REACTION__M__2
TT 11359 "Unut..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME__M__1
TT 11360 "G'alati..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME__M__2
TT 11361 "Hech narsa - qanday kutilmagan holat... Ha! O'z pozitsiyalarimizga qaytamiz!" VO__VILLAGER_M3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER__M__1
TT 11362 "Yo'q, hamon hech narsa yo'q... Juda g'alati..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER__M__2
TT 11363 "Yana bir bor hech narsa... Xo'sh... Joyingga qayt..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER_ALONE__M__1
TT 11364 "Hamon hech narsa... Lekin boshqa aldanmayman..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_AGAIN_SPOTTER_ALONE__M__2
TT 11365 "U yerda hech narsa yo'q, kechirasiz!" VO__VILLAGER_M3__GENERIC__PATROL_RESUME_SPOTTER__M__1
TT 11366 "Hech narsa topilmadi..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_SPOTTER__M__2
TT 11367 "Hech narsa... Mayli..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_SPOTTER_ALONE__M__1
TT 11368 "Kimsasiz... Xo'sh, men nolib o'tirmayman..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_SPOTTER_ALONE__M__2
TT 11369 "Nima bo'lganda ham shunday bo'lgani yaxshiroq..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_WATCHER__M__1
TT 11370 "Nima bo'lsa ham..." VO__VILLAGER_M3__GENERIC__PATROL_RESUME_WATCHER__M__2
TT 11371 "Qidirishda davom eting... Parvardigor kuzatib turibdi!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH__M__1
TT 11372 "Ikkinchi imkoniyat yo'q... Biz ularni topishimiz kerak, zudlik bilan!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH__M__2
TT 11373 "O'zingni ko'rsat, maxluqlar!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_ALONE__M__1
TT 11374 "Ular yerning tagiga kirib ketishdimi?" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_ALONE__M__2
TT 11375 "Yaramaslar yaxshi yashirinishibdi..." VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_ANSWER__M__1
TT 11376 "O'sha yerni tekshirib ko'raman!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_ANSWER__M__2
TT 11377 "A? Lekin... Ular qayerga ketishdi?" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_BLOCKED__M__1
TT 11378 "Shu tomonga. Ularni yo'qotib qo'ymanglar!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_FOUND__M__1
TT 11379 "Ularni topdim! Yordam bering!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_FOUND__M__2
TT 11380 "Nihoyat! Bu og'riqli bo'ladi, sizga va'da beraman!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_FOUND_ALONE__M__1
TT 11381 "Ha ha! O'zingizga munosib o'lim vaqti keldi!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_FOUND_ALONE__M__2
TT 11382 "Unut, ular ketishdi!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_RETURN__M__1
TT 11383 "Bu yerda hech kim yo'q. Ehtimol hozircha uzoqlarga ketishgandir!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_RETURN__M__2
TT 11384 "Yetar shuncha. Bu yerda hech kim yo'q." VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_RETURN_ALONE__M__1
TT 11385 "To'liq sukunat... Boshqa qidirishning foydasi yo'q!" VO__VILLAGER_M3__GENERIC__PATROL_SEARCH_RETURN_ALONE__M__2
TT 11386 "Yana o'sha narsa... Menga bu yoqmayapti! Men o'sha yoqqa boryapman!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AGAIN_SPOTTER__M__1
TT 11387 "Yana bir iflos hiylami? Menga bu yoqmayapti. Yaxshisi qarab kelaman!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AGAIN_SPOTTER__M__2
TT 11388 "Yana o'sha narsa! G'alati... Buni o'zim ko'rishim kerak..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AGAIN_SPOTTER_ALONE__M__1
TT 11389 "Bu nima? Yana la'natmi? Borib ko'raman..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AGAIN_SPOTTER_ALONE__M__2
TT 11390 "Buni eshitdingizmi? O'zim hal qilaman." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER__M__1
TT 11391 "Kimnidir eshitdim. Hozir qaytaman." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER__M__2
TT 11392 "Eh?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER__M__3
TT 11393 "Nima balo...?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER__M__4
TT 11394 "Bu qanday xunuk shovqin?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__1
TT 11395 "U yerda qandaydir shovqin bo'ldi, bu aniq..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__2
TT 11396 "Eh?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__3
TT 11397 "Nima balo...?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_AUDIO_SPOTTER_ALONE__M__4
TT 11398 "Yana o'sha bolalarmi? Hmff! Qarab kelaman!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER__M__1
TT 11399 "Ishonchim komilki, yana ular! Qarab kelaman!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER__M__2
TT 11400 "Ularning yana bir iflos hiylasi... Qani borib ko'raylik-chi..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER_ALONE__M__1
TT 11401 "Bu ular... Haliyam men bilan o'ynashyapti. Qarab tur..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_ORPHANS_SPOTTER_ALONE__M__2
TT 11402 "Bu tomonga borishim kerak! Nimadir qisir etganini eshitdim..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SLING_SPOTTER__M__1
TT 11403 "U yerdan qisir etgan ovoz keldi! Qarab kelaman!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SLING_SPOTTER__M__2
TT 11404 "U yerda nimadir qisir etganini eshitdim..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SLING_SPOTTER_ALONE__M__1
TT 11405 "U yerdan qisirlagan ovoz keldi..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SLING_SPOTTER_ALONE__M__2
TT 11406 "U yerda kimdir bormi? Borib ko'rib kelaman!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SPOTTER__M__1
TT 11407 "Nimaligini ayta olmayman... Borib ko'rib kelaman..." VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SPOTTER__M__2
TT 11408 "U yerdagi nima o'zi?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SPOTTER_ALONE__M__1
TT 11409 "Ha, harakat bor! Lekin, bu nima o'zi?" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_SPOTTER_ALONE__M__2
TT 11410 "Orqangizga qarab yuring, jin izg'ib yuribdi!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_WATCHER__M__1
TT 11411 "O'zingizni jarohatlab olmang!" VO__VILLAGER_M3__GENERIC__PATROL_SUSPICION_WATCHER__M__2
TT 11412 "Bunga pushaymon bo'lasan!" VO__VILLAGER_M3__GENERIC__PATROL_TAUNTED__M__1
TT 11413 "Bu opangmi? Ajoyib..." VO__VILLAGER_M3__GENERIC__PATROL_TAUNTED__M__2
TT 11414 "Men seni taniyman... Amisiya de Run..." VO__VITALIS__CH7__RTC_STYX_003__M__1
TT 11415 "Kichkina ahmoq! Bu kitob bilan nima qilmoqchisan o'zi?" VO__VITALIS__CH7__RTC_STYX_005__M__1
TT 11416 "Ukang va bu kitob orqali men dunyoni qutqara olaman, Amisiya." VO__VITALIS__CH7__RTC_STYX_007__M__1
TT 11417 "Soqchilar!" VO__VITALIS__CH7__RTC_STYX_009__M__1
TT 11418 "Qochishingiz mumkin... lekin hech kim o'z qonidan qochib qutulolmaydi!" VO__VITALIS__CH7__RTC_STYX_010__M__1
TT 11419 "Biz sening oilangni ancha vaqtdan beri kuzatib kelmoqdamiz, ukangning qonidagi Makula o'z uyqusini tugatishini kutdik. Seni ko'z o'ngimda o'sib-ulg'aygan deyishim ham mumkin." VO__VITALIS__CH7__RTC_STYX_011__M__1
TT 11420 "Yosh Hyugo de Rundan... hamon yangilik yo'qmi?" VO__VITALIS__CH7__RTC_VITALIS_001__M__1
TT 11421 "Bunday holatda kitobni topishimizga yordam beradigan yagona narsa bu... temirchining o'g'li." VO__VITALIS__CH7__RTC_VITALIS_003__M__1
TT 11422 "Sen bu eshikni otang bilan qurgan eding. Endi uni biz uchun ochasan..." VO__VITALIS__CH7__RTC_VITALIS_004__M__1
TT 11423 "Men Buyuk Inkvizitor Vitalis Beneventman! Men qanchalik azob chekkanimni tasavvur ham qilolmaysan!" VO__VITALIS__CH7__RTC_VITALIS_006__M__1
TT 11424 "Sen uchun nimalarga chidaganimni qara..." VO__VITALIS__CH7__RTC_VITALIS_007__M__1
TT 11425 "Tezroq, Episangvisni!" VO__VITALIS__CH7__RTC_VITALIS_008__M__1
TT 11426 "Isming nima, bolakay?" VO__VITALIS__CH7__RTC_VITALIS_009__M__1
TT 11427 "Bu eshikni ochmasdan turib Rodrikning o'lishini xohlamayman. Otasi bilan qilgan xatongni takrorlama... Uni olib ketinglar!" VO__VITALIS__CH7__RTC_VITALIS_011__M__1
TT 11428 "VO__VITALIS__CH7__RTC_VITALIS_ONOM_INJECTION__M__1" VO__VITALIS__CH7__RTC_VITALIS_ONOM_INJECTION__M__1
TT 11429 "Prima Makula... U ta'sir qilyapti! DAVOM ETING!" VO__VITALIS__CH11__CHATTER_FIFTH_STEP_OK_003__M__1
TT 11430 "Ha! Ularni yeb bitiring! Ostonada kutilyapti! Narigi tomonga o'ting!" VO__VITALIS__CH11__CHATTER_LAST_STEP_007__M__1
TT 11431 "OLDIMGA KELING!" VO__VITALIS__CH11__CHATTER_LAST_STEP_009__M__1
TT 11432 "Ajoyib. Uni ichkariga kiriting." VO__VITALIS__CH11__CHATTER_PRIEST_ARRIVAL_002__M__1
TT 11433 "Mukammal." VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_002__M__1
TT 11434 "Uni olib kiring." VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_002__M__2
TT 11435 "Monsenyor Gote. Safaringiz yaxshi o'tdi deb umid qilaman?" VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_004__M__1
TT 11436 "O'yin deysizmi, Arxiyepiskop? Qandaydir 'o'yin' dunyo kelajagini o'zgartira oladimi?" VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_007__M__1
TT 11437 "Ijozat bersangiz... Bu muhim." VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_009__M__1
TT 11438 "Buni sinab ko'rdingizmi?" VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_011__M__1
TT 11439 "Farqi yo'q. Agar kitoblar to'g'ri bo'lsa, mening qonim uniki bilan bog'lanadi. U navbatdagi ostonaga yetganida, men ham u bilan birga yetaman... Davom eting." VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_013__M__1
TT 11440 "Odamni dindan chiqarish mumkin, Arxiyepiskop... lekin avliyoni emas." VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_015__M__1
TT 11441 "Ya'ni yangi davr boshlanmoqda! Senga o'xshagan qo'g'irchoqlar tiz cho'kib, ularni qutqarishimni yolvorib so'raydigan davr!" VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_017__M__1
TT 11442 "Juda yaxshi. Borib qara, Beatris de Run o'ziga keldimi yo'qmi." VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_019__M__1
TT 11443 "VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_ONOM_022__M__1" VO__VITALIS__CH11__RTC_HUMAN_CRUCIBLE_ONOM_022__M__1
TT 11444 "Demak, Beatris, nihoyat o'g'ling bilan qayta topishding..." VO__VITALIS__CH11__RTC_VITALIS2_001__M__1
TT 11445 "Meni haqorat qilyapsan, xonim De Run... O'g'ling Makulaning tabiiy tashuvchisi, va u hali u bilan ishini tugatgani yo'q, ya'ni... men ham tugatmadim. Lekin buni o'zing ham bilasan." VO__VITALIS__CH11__RTC_VITALIS2_003__M__1
TT 11446 "Nikolay... Siz tushuna olmaysiz..." VO__VITALIS__CH11__RTC_VITALIS2_005__M__1
TT 11447 "Buni xuddi mendek his qilyapsan, shundaymi bolakay? Biz endi qon orqali bog'langanmiz... Nima deysan Hyugo? Oilang kengaymoqda..." VO__VITALIS__CH11__RTC_VITALIS2_006__M__1
TT 11448 "Uning qismati De Run bo'lish emas... Uning qismati bu yerda, mening yonimda bo'lish." VO__VITALIS__CH11__RTC_VITALIS2_008__M__1
TT 11449 "Maxluq? Xonim... buning aslida qandayligini hali ko'rishingiz kerak." VO__VITALIS__CH11__RTC_VITALIS2_010__M__1
TT 11450 "U juda kuchli, lekin biz umid qilgan ostonaga hali yetib bormadi..." VO__VITALIS__CH11__RTC_WAKE_UP_003__M__1
TT 11451 "Qanday zerikarli... lekin u hozir juda yaqin, va bizda o'ynashimiz mumkin bo'lgan boshqa piyodalar ham bor." VO__VITALIS__CH11__RTC_WAKE_UP_007__M__1
TT 11452 "Yana juda ko'p narsa. Va biz unga erishishimizni ta'minlash uchun men bilan bu yerda qolasan." VO__VITALIS__CH11__RTC_WAKE_UP_010__M__1
TT 11453 "Xavotir olma Hyugo, men senga to'liq ishonaman... Biz g'alaba qozonamiz." VO__VITALIS__CH11__RTC_WAKE_UP_011__M__1
TT 11454 "VO__VITALIS__CH11__RTC_WAKE_UP_ONOM_011__M__1" VO__VITALIS__CH11__RTC_WAKE_UP_ONOM_011__M__1
TT 11455 "O'l! Yana birlash!" VO__VITALIS__CH14__CHATTER_FIRST_THREAT_001__M__3
TT 11456 "Yonimga kel! Kel oziqlan... Ilk qon... Ishonch va tinchlikda... Yangilanish!" VO__VITALIS__CH14__CHATTER_FIRST_THREAT_002__M__1
TT 11457 "Hamma narsa birlashadigan manba bo'lish uchun... o'z tanamni qurbon qildim... Yuksaltirilgan narsani... sen o'ldirolmaysan!" VO__VITALIS__CH14__CHATTER_FIRST_THREAT_003__M__1
TT 11458 "Bu ramzlarning oxiri! Nutqlarning! Soxta e'tiqodlarning! Faqat bitta qirol bo'lishi mumkin... va u men bo'laman!" VO__VITALIS__CH14__CHATTER_FIRST_THREAT_004__M__1
TT 11459 "Ana xolos!" VO__VITALIS__CH14__CHATTER_GATHERING_THE_RATS_002__M__1
TT 11460 "Ha! U juda iqtidorli o'quvchi! Faqat unga bilgan hamma narsasini kim o'rgatganini unutib qo'ygani juda yomon!" VO__VITALIS__CH14__CHATTER_GATHERING_THE_RATS_005__M__1
TT 11461 "Va endi o'zingga qara... Xuddi adashgan qo'ylar o'z cho'poni tomon kelayotgandek menga qarab kelyapsan!" VO__VITALIS__CH14__CHATTER_GATHERING_THE_RATS_007__M__1
TT 11462 "Yoki nima bo'ladi o'zi? Men Tashuvchiga... va uning do'stlariga o'rgatadigan narsalarim hali bor..." VO__VITALIS__CH14__CHATTER_GATHERING_THE_RATS_009__M__1
TT 11463 "Yashavor! Yonimga qaytinglar!" VO__VITALIS__CH14__CHATTER_GENERIC_THREAT__M__1
TT 11464 "A... Yana birlashdik!" VO__VITALIS__CH14__CHATTER_GENERIC_THREAT__M__2
TT 11465 "Bu bilan hali tugamadi!" VO__VITALIS__CH14__CHATTER_GENERIC_THREAT__M__3
TT 11466 "Ortga... Uyg'unlikka qaytamiz!" VO__VITALIS__CH14__CHATTER_GENERIC_THREAT__M__4
TT 11467 "Ortga qaytinglar! Bu yer endi sizniki emas!" VO__VITALIS__CH14__CHATTER_RATCIRCLE_SPAWNING_001__M__1
TT 11468 "Ko'taril! Qayta tug'ilar ekansan, yerni yorib o't!" VO__VITALIS__CH14__CHATTER_RATCIRCLE_SPAWNING_001__M__2
TT 11469 "Bu seni hududing emas!" VO__VITALIS__CH14__CHATTER_RATCIRCLE_SPAWNING_001__M__3
TT 11470 "Qayerga borsang ham... Ular seni topishadi!" VO__VITALIS__CH14__CHATTER_RATCIRCLE_SPAWNING_001__M__4
TT 11471 "HA! Yo'q... Yo'q, buning imkoni yo'q! Bunga tovon to'laysan!" VO__VITALIS__CH14__CHATTER_RATSHAPE_FIRST_SUCCESS_1_001__M__1
TT 11472 "Og'riq mening asoyimdir! U o'zingga qarshi o'giriladi!" VO__VITALIS__CH14__CHATTER_RATSHAPE_FIRST_SUCCESS_2_001__M__1
TT 11473 "Qaytinglar, izdoshlarim! O'z xojangiz huzuriga qaytinglar!" VO__VITALIS__CH14__CHATTER_RATSHAPE_RECALL_001__M__1
TT 11474 "Oldimga kelinglar! Biz bir butun bo'lamiz! Tez orada, ular ham bizga qo'shiladi." VO__VITALIS__CH14__CHATTER_RATSHAPE_RECALL_001__M__2
TT 11475 "Farishtalarim! Ochqaganingizni bilaman. Tez orada, tez orada oziqlanasiz!" VO__VITALIS__CH14__CHATTER_RATSHAPE_RECALL_001__M__3
TT 11476 "Sabr qiling! Ular sizniki! Hammasi sizniki!" VO__VITALIS__CH14__CHATTER_RATSHAPE_RECALL_001__M__4
TT 11477 "HA! Qanday... jur'at qilding? Bu sening so'nggi haqorating bo'ladi!" VO__VITALIS__CH14__CHATTER_RATSHAPE_SECOND_SUCCESS_1_001__M__1
TT 11478 "Va xizmatkorlarim osmon sari ko'tariladi..." VO__VITALIS__CH14__CHATTER_RATTOWER_WARNING_001__M__1
TT 11479 "Farishtalar to'dasi eski tana ustiga tushadi..." VO__VITALIS__CH14__CHATTER_RATTOWER_WARNING_001__M__2
TT 11480 "Men Makulaning quroliman! Nurli qilichman!" VO__VITALIS__CH14__CHATTER_RATTOWER_WARNING_001__M__3
TT 11481 "Ko'tariling! Va g'azab bilan zarba bering!" VO__VITALIS__CH14__CHATTER_RATTOWER_WARNING_001__M__4
TT 11482 "Hahaha! Bu o'yinchoq bilan nima qilyapman deb o'ylayapsan?" VO__VITALIS__CH14__CHATTER_ROCK_FAIL_001__M__1
TT 11483 "Kulgili!" VO__VITALIS__CH14__CHATTER_ROCK_FAIL_001__M__2
TT 11484 "Bundan ham yaxshiroq harakat qilishingga to'g'ri keladi!" VO__VITALIS__CH14__CHATTER_ROCK_FAIL_001__M__3
TT 11485 "Xudoni shu yo'sinda yengmoqchimisan o'zi?" VO__VITALIS__CH14__CHATTER_ROCK_FAIL_001__M__4
TT 11486 "Sen shunchaki kuchsiz va e'tiqodsiz bir qizchasan!" VO__VITALIS__CH14__CHATTER_ROCK_FAIL_001__M__5
TT 11487 "Qayta saf torting! Olg'a!" VO__VITALIS__CH14__CHATTER_SHAPE_WARNING_001__M__1
TT 11488 "Birlashing va ularni yeb bitiring!" VO__VITALIS__CH14__CHATTER_SHAPE_WARNING_001__M__2
TT 11489 "Ko'tariling va ularni bo'g'ing!" VO__VITALIS__CH14__CHATTER_SHAPE_WARNING_001__M__3
TT 11490 "Kuchlaringizni birlashtiring!" VO__VITALIS__CH14__CHATTER_SHAPE_WARNING_001__M__4
TT 11491 "Ularga bir butun bo'lib yuzlaning!" VO__VITALIS__CH14__CHATTER_SHAPE_WARNING_001__M__5
TT 11492 "Ularning ishini bitiring!" VO__VITALIS__CH14__CHATTER_SHAPE_WARNING_001__M__6
TT 11493 "Tomosha qil, Beatris! Avlodingdan qolgan so'nggi narsalarning ham yo'q bo'lishiga guvoh bo'l!" VO__VITALIS__CH14__CHATTER_VITALIS_1_001__M__1
TT 11494 "Xato! Ular shunchaki eski dunyodan qolgan yodgorliklar xolos!" VO__VITALIS__CH14__CHATTER_VITALIS_1_003__M__1
TT 11495 "Sen menga qarshi chiqishga kelding! Menga! Vitalis Beneventga! Prima Makula tashuvchisiga! Qon bilan tojlangan zotga!" VO__VITALIS__CH14__CHATTER_VITALIS_2_001__M__1
TT 11496 "Iymonimning kuchiga past baho beryapsan!" VO__VITALIS__CH14__CHATTER_VITALIS_2_004__M__1
