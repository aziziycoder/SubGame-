TT 8569 "Yalpiz, chinnigul... Bu emas." VO__LUCAS__CH9__CHATTER_FIND_POTS_3_002__M__1
TT 8570 "Bug' bilan, ha... Bu..." VO__LUCAS__CH9__CHATTER_FIRST_STEPS_002__M__1
TT 8571 "Oh! Qara! Anavi haykallar!" VO__LUCAS__CH9__CHATTER_FIRST_STEPS_003__M__1
TT 8572 "Beshbargli gul... O'ylashimcha..." VO__LUCAS__CH9__CHATTER_FLOWER_INTERACT_001__M__1
TT 8573 "Ajoyib, uni menga olib kel!" VO__LUCAS__CH9__CHATTER_FOUND_POTION_002__M__1
TT 8574 "Hammom qayerda?" VO__LUCAS__CH9__CHATTER_GARDEN_VISTA_002__M__1
TT 8575 "Biz shundan o'tishimiz kerakmi? Lekin..." VO__LUCAS__CH9__CHATTER_GARDEN_VISTA_004__M__1
TT 8576 "Shunga qo'y!" VO__LUCAS__CH9__CHATTER_GIVE_IT_TO_ME_001__M__1
