TT 5740 "E'tiborsiz bo'lma!" VO__GUARD1__GENERIC__PATROL_SUSPICION_WATCHER__M__4
TT 5741 "Demak u shu yerda ekan!" VO__GUARD1__GENERIC__PATROL_TAUNTED__M__1
TT 5742 "Uni qutqarmoqchimisan? Juda yoqimtoy..." VO__GUARD1__GENERIC__PATROL_TAUNTED__M__2
TT 5743 "Juda jasur bolasan." VO__GUARD1__GENERIC__PATROL_TAUNTED__M__3
TT 5744 "Nima qilyapman deb o'ylayapsan?" VO__GUARD1__GENERIC__PATROL_TAUNTED__M__4
TT 5745 "Bolani topinglar! Yo'lingizdan chiqqan barchani o'ldiring!" VO__GUARD2__CH1__CHATTER_CAPTURE_KIDS_005__M__1
TT 5746 "Opasini o'ldiringlar! Bolani tiriklayin olinglar!" VO__Guard2__CH1__CHATTER_CHASE_WOODS_001__M__1
TT 5747 "Jin ursin, nimalar bo'lyapti o'zi? Bolani qutqaring!" VO__Guard2__CH1__CHATTER_CHASE_WOODS_003__M__1
TT 5748 "Xo'sh? Bola-chi?" VO__Guard2__CH1__CHATTER_CLEAR_ORDERS_001__M__1
TT 5749 "U Buyuk Inkvizitorning o'ng qo'li. Soqchilarda hech qachon undan zo'r kapitan bo'lmagan." VO__Guard2__CH1__CHATTER_CLEAR_ORDERS_003__M__1
TT 5750 "Va tez orada o'g'ilni oladi." VO__Guard2__CH1__CHATTER_CLEAR_ORDERS_005__M__1
TT 5751 "Hoy! Yana bittasini topdim!" VO__GUARD2__CH1__CHATTER_FLEEING_SERVANT_001__M__1
TT 5752 "Bog'bon. Oila haqida yaxshi biladi. Bolalarning ulg'ayganini ko'rganman deyapti..." VO__GUARD2__CH1__CHATTER_FLEEING_SERVANT_003__M__1
TT 5753 "Jim bo'l! Qimirla!" VO__GUARD2__CH1__CHATTER_FLEEING_SERVANT_007__M__1
