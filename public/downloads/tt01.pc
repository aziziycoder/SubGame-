TT 3578 "Meli, qobiliyatlaring kerak bo'ladi. Eshik muhrlangan..." VO__AMICIA__CH5__CHATTER_NEED_YOUR_SERVICE_001__M__1
TT 3579 "U yerda bitta dasta bor!" VO__AMICIA__CH5__CHATTER_NEXT_LEVER_002__M__1
