TT 4524 "Yolg'izmi?" VO__AMICIA__CH14__CHATTER_PORTCULLIS_003__M__2
TT 4525 "Oyog'imning tagi qimirlayapti!" VO__AMICIA__CH14__CHATTER_RATCIRCLE_SPAWNING_002__M__1
TT 4526 "Yer... Yer qimirlayapti!" VO__AMICIA__CH14__CHATTER_RATCIRCLE_SPAWNING_002__M__2
