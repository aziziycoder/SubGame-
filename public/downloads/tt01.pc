TT 3535 "Nima? Meli - Qahrmonmi?" VO__AMICIA__CH5__CHATTER_HAPPY_ENDING_004__M__1
TT 3536 "Hyugo... Bu 'akveduk'..." VO__AMICIA__CH5__CHATTER_HARD_TO_CLIMB_002__M__1
TT 3537 "Bu yordam berishi kerak..." VO__AMICIA__CH5__CHATTER_HAY_LIT_001__M__1
TT 3538 "Ha..." VO__AMICIA__CH5__CHATTER_HELMET_AGAIN_002__M__1
TT 3539 "Uning dubulg'asi bor ekan..." VO__AMICIA__CH5__CHATTER_HELMET_ON_001__M__1
