TT 5813 "Agar jasorat qilsam... Biz uning anavi kalamushlardan kelishini bilamiz, lekin... nima uchun o'zi u?" VO__Guard2__CH7__RTC_ATTRACTED_003__M__1
TT 5814 "Voy!" VO__Guard2__CH7__RTC_ATTRACTED_005__M__1
