TT 3292 "Albatta, biz Meli bilan birga boramiz. U bizga yordam berish uchun shu yerda." VO__AMICIA__CH4__CHATTER_CAGE_EVENT_INTERACT_003__M__1
TT 3293 "Va u bizni boya tutib bergani uchun uzr so'rayapti. Shunday emasmi, Meli?" VO__AMICIA__CH4__CHATTER_CAGE_EVENT_INTERACT_003__M__2
TT 3294 "Qo'limdan tut, Hyugo. Ketdik." VO__AMICIA__CH4__CHATTER_CAGE_EVENT_INTERACT_005__M__1
TT 3295 "Mmh..." VO__AMICIA__CH4__CHATTER_CAGE_EVENT_INTERACT_008__M__1
TT 3296 "Cho'zmam bilan Hyugoni ozod qila olishim kerak..." VO__AMICIA__CH4__CHATTER_CAGE_REMINDER__M__1
TT 3297 "Hyugo! Qayerga ketyapsan?" VO__AMICIA__CH4__CHATTER_CALLING_HUGO_001__M__1
TT 3298 "Hyugo!" VO__AMICIA__CH4__CHATTER_CALLING_HUGO_002__M__1
TT 3299 "Bilaman, Hyugo... lekin... bizning boshqa choramiz yo'q..." VO__AMICIA__CH4__CHATTER_CANT_GO_002__M__1
TT 3300 "Yo'q, bo'lishi mumkin emas..." VO__AMICIA__CH4__CHATTER_CAPTAIN_TALK_007__M__1
TT 3301 "Buni shu yerda qoldirishga majburmiz... Qani, yuraqol..." VO__AMICIA__CH4__CHATTER_CART_STOP_002__M__1
TT 3302 "Sovuq qotmayapsanmi?" VO__AMICIA__CH4__CHATTER_CASTLE_001__M__1
TT 3303 "Hyugoga farqi yo'qdek ko'rinadi..." VO__AMICIA__CH4__CHATTER_CASTLE_003__M__1
TT 3304 "Ha, lekin u men xohlaganimdan ko'ra ancha uzoqda..." VO__AMICIA__CH4__CHATTER_CASTLE_005__M__1
TT 3305 "Shshh!" VO__AMICIA__CH4__CHATTER_CORNERED_003__M__1
TT 3306 "Oh yo'q..." VO__AMICIA__CH4__CHATTER_CORNERED_006__M__1
TT 3307 "Kechirasan... Biz bu yerdan chiqishimiz kerak!" VO__AMICIA__CH4__CHATTER_CORNERED_008__M__1
TT 3308 "Hyugo, qarama!" VO__AMICIA__CH4__CHATTER_CORNERED_011__M__1
TT 3309 "Biz bu yerda bo'lmasligimiz kerak edi..." VO__AMICIA__CH4__CHATTER_CROSS_BATTLEFIELD_001__M__1
TT 3310 "Qarama... Diqqatingni akvedukka qarat..." VO__AMICIA__CH4__CHATTER_CROSS_BATTLEFIELD_004__M__1
TT 3311 "Mening ukammi?" VO__AMICIA__CH4__CHATTER_CROWD_001__M__1
TT 3312 "Tezroq..." VO__AMICIA__CH4__CHATTER_CROWD_003__M__1
TT 3313 "Ular juda ham ko'p..." VO__AMICIA__CH4__CHATTER_DEAD_END_001__M__1
TT 3314 "Oh yo'q..." VO__AMICIA__CH4__CHATTER_DECOY_003__M__1
TT 3315 "Biz... Biz ular bilan birga emasmiz!" VO__AMICIA__CH4__CHATTER_DECOY_004__M__1
TT 3316 "Mana bu shishalarmi?" VO__AMICIA__CH4__CHATTER_DISTRACT1_CHOICE_1_001__M__1
TT 3317 "Nima? Qanday?" VO__AMICIA__CH4__CHATTER_DISTRACT1_CHOICE_002__M__2
TT 3318 "Ko'zachalarmi?" VO__AMICIA__CH4__CHATTER_DISTRACT1_CHOICE_2_001__M__1
TT 3319 "Arava!" VO__AMICIA__CH4__CHATTER_DISTRACT1_OK_001__M__1
TT 3320 "Nima uchun?" VO__AMICIA__CH4__CHATTER_DISTRACT1_OK_003__M__1
TT 3321 "Buni ko'ryapsanmi?" VO__AMICIA__CH4__CHATTER_DISTRACT2_CHOICE_1_001__M__1
TT 3322 "Mangal metaldan yasalgan!" VO__AMICIA__CH4__CHATTER_DISTRACT2_CHOICE_2_001__M__1
TT 3323 "Nayzalar solingan bochka!" VO__AMICIA__CH4__CHATTER_DISTRACT2_OK_001__M__1
TT 3324 "Bunga nima deysan!" VO__AMICIA__CH4__CHATTER_DISTRACT3_CHOICE_1_001__M__1
TT 3325 "Tepalik, anavi yerda!" VO__AMICIA__CH4__CHATTER_DISTRACT3_CHOICE_2_001__M__1
TT 3326 "Qara... Qozon..." VO__AMICIA__CH4__CHATTER_DISTRACT3_OK_001__M__1
TT 3327 "Men ularning chorasini ko'raman!" VO__AMICIA__CH4__CHATTER_DOOR_BANGING_003__M__1
TT 3328 "Tayyorlan!" VO__AMICIA__CH4__CHATTER_DRY_CROPS_002__M__1
TT 3329 "Yo Parvardigor... Bu dahshat..." VO__AMICIA__CH4__CHATTER_DYING_GUARD_001__M__1
TT 3330 "Qani, ichkariga, tezroq!" VO__AMICIA__CH4__CHATTER_ENTERING_TOWER_001__M__1
TT 3331 "Oh yo'q..." VO__AMICIA__CH4__CHATTER_ENTERING_TOWER_003__M__1
TT 3332 "O'tib olishimiz uchun bizga olov kerak bo'ladi..." VO__AMICIA__CH4__CHATTER_FIND_LIGHT_001__M__1
TT 3333 "Xo'sh, urinib ko'rishimiz kerak." VO__AMICIA__CH4__CHATTER_FIND_LIGHT_003__M__1
TT 3334 "Tayyorlaning! Biz yorug'likda qolishimiz kerak!" VO__AMICIA__CH4__CHATTER_FLAMING_CART_AIM__M__1
TT 3335 "Ketdik! Qani!" VO__AMICIA__CH4__CHATTER_FLAMING_CART_GO_001__M__1
TT 3336 "Yo'q! Yugur!" VO__AMICIA__CH4__CHATTER_FLAMING_CART_GO_003__M__1
TT 3337 "Hozircha hammasi o'xshayapti!" VO__AMICIA__CH4__CHATTER_FLAMING_CART_GO_005__M__1
TT 3338 "Hyugo, bu haqda gaplashgan edik. Ehtiyot bo'l!" VO__AMICIA__CH4__CHATTER_FLOWER_CLOSE_002__M__1
TT 3339 "Ular shunchalik chiroyliki..." VO__AMICIA__CH4__CHATTER_FLOWER_INTERACT_001__M__1
TT 3340 "Ular senga yoqmayaptimi?" VO__AMICIA__CH4__CHATTER_FLOWER_INTERACT_005__M__1
TT 3341 "Hyugo, bular shunchaki gullar!" VO__AMICIA__CH4__CHATTER_FLOWER_INTERACT_007__M__1
TT 3342 "Men kelayapman!" VO__AMICIA__CH4__CHATTER_FOUND_LADDER_004__M__1
TT 3343 "Ularning seni tutib olishiga yo'l qo'ymayman!" VO__AMICIA__CH4__CHATTER_FOUND_LADDER_005__M__1
TT 3344 "Ular hammayoqda..." VO__AMICIA__CH4__CHATTER_FROM_ABOVE_002__M__1
TT 3345 "Qarama..." VO__AMICIA__CH4__CHATTER_HANGED_002__M__1
TT 3346 "Shunday deb o'ylaysanmi?" VO__AMICIA__CH4__CHATTER_HANGED_DOWN_001__M__1
TT 3347 "Qiyin qismini Hyugo bajardi!" VO__AMICIA__CH4__CHATTER_HEROES_RETURN_002__M__1
TT 3348 "Men ham. Qani, ketdik!" VO__AMICIA__CH4__CHATTER_HEROES_RETURN_004__M__1
TT 3349 "Hyugoni olib ketishim kerak, u qo'rqib ketgan bo'lsa kerak..." VO__AMICIA__CH4__CHATTER_HUGO_CAGE_REMINDER__M__1
TT 3350 "Oh, haromxo'rlar... Razillar!" VO__AMICIA__CH4__CHATTER_HUGO_IN_SIGHT_001__M__1
TT 3351 "Qani, yuraqol..." VO__AMICIA__CH4__CHATTER_HUGO_RUNNING__M__1
TT 3352 "Senga nima bo'ldi?" VO__AMICIA__CH4__CHATTER_HUGO_STRESS_002__M__1
TT 3353 "U qo'rqyapti... Biz bu yerdan ketishimiz kerak... Hyugo... Hyugo! Qurbaqalarni o'yla! Ularning qanday sakrashini eslaysanmi? Sen ularni quvlayotgan eding... Qani! Yur, yana boshqalarini ko'ramiz!" VO__AMICIA__CH4__CHATTER_HUGO_STRESS_005__M__1
TT 3354 "Albatta ko'ramiz. Bu joy abadiy davom etishi mumkin emas, shundaymi?" VO__AMICIA__CH4__CHATTER_HUGO_STRESS_007__M__1
TT 3355 "Chalg'i..." VO__AMICIA__CH4__CHATTER_INTERACT_ARTIFACT_001__M__1
TT 3356 "Bu qanaqa burg'u?" VO__AMICIA__CH4__CHATTER_INTERACT_ARTIFACT_004__M__1
TT 3357 "Bu inglizlarning urush deklaratsiyasi! Eduard III Fransiya taxtiga da'vo qilyapti..." VO__AMICIA__CH4__CHATTER_INTERACT_ARTIFACT_006__M__1
TT 3358 "To'g'ri, lekin sen o'g'risan, u esa — qirol..." VO__AMICIA__CH4__CHATTER_INTERACT_ARTIFACT_008__M__1
TT 3359 "Tangalar... Ularni olmaysanmi?" VO__AMICIA__CH4__CHATTER_INTERACT_ARTIFACT_010__M__1
TT 3360 "U ifloslar cho'zmamni olib qo'yishdi..." VO__AMICIA__CH4__CHATTER_JOIN_ME_002__M__1
TT 3361 "Bo'laqol..." VO__AMICIA__CH4__CHATTER_KILLSTREAK_001__M__1
TT 3362 "Yana xohlaysanmi? Mendan hali chiqadi..." VO__AMICIA__CH4__CHATTER_KILLSTREAK_002__M__1
TT 3363 "Bizni tinch qo'ying!" VO__AMICIA__CH4__CHATTER_KILLSTREAK_003__M__1
TT 3364 "Charchadim... buyumdek muomalada bo'lishlaridan! Yur, qasrni qidiramiz..." VO__AMICIA__CH4__CHATTER_KILLSTREAK_006__M__1
TT 3365 "Ovozingni o'chir! O'chir ovozingni! Bizni holi qo'ying!" VO__AMICIA__CH4__CHATTER_LAST_STAND_002__M__1
TT 3366 "Uni unutganim yo'q!" VO__AMICIA__CH4__CHATTER_LEAVING_ALONE_1_002__M__1
TT 3367 "Bilaman! Men uni u yerdan olib chiqaman!" VO__AMICIA__CH4__CHATTER_LEAVING_ALONE_2_002__M__1
TT 3368 "Yo'q!... Mash'ala..." VO__AMICIA__CH4__CHATTER_LOSING_TORCH__M__1
TT 3369 "Meli! U yo'ldan emas, u yerda ular juda ko'p!" VO__AMICIA__CH4__CHATTER_MESS_002__M__1
TT 3370 "O'tlar orasiga, tezroq! U bizni ko'rib qolmasligi kerak!" VO__AMICIA__CH4__CHATTER_MUST_HIDE__M__1
TT 3371 "Nihoyat... Endi esa Hyugo... Qafasni pastga tushirishim kerak." VO__AMICIA__CH4__CHATTER_MY_STUFF__M__1
TT 3372 "Shshsh... Biror yo'lini topamiz..." VO__AMICIA__CH4__CHATTER_NEED_LIGHT_002__M__1
TT 3373 "Ehtiyot bo'l..." VO__AMICIA__CH4__CHATTER_NEW_PROBLEM__M__1
TT 3374 "Tushunarli..." VO__AMICIA__CH4__CHATTER_NO_ATTENTION_002__M__1
TT 3375 "Xo'p bo'ladi." VO__AMICIA__CH4__CHATTER_NO_MANS_LAND_002__M__1
TT 3376 "Bizda ko'p vaqt yo'q!" VO__AMICIA__CH4__CHATTER_NOT_SAFE_YET_002__M__1
TT 3377 "Yo tavba..." VO__AMICIA__CH4__CHATTER_OH_GOD__M__1
TT 3378 "Jin ursin..." VO__AMICIA__CH4__CHATTER_OPEN_TOWER_001__M__1
TT 3379 "Lukas, buning bizga biror foydasi tegadimi?" VO__AMICIA__CH4__CHATTER_PICKUP_GIFT_001__M__1
TT 3380 "Oshiqlar... Hyugo uchun... Bu yerdan uzoqlashganimizda..." VO__AMICIA__CH4__CHATTER_PICKUP_GIFT_007__M__1
TT 3381 "Barakalla, Hyugo, ana shunday!" VO__AMICIA__CH4__CHATTER_QUIET_CHEERLEADER__M__1
TT 3382 "E-e... Ot... Lukas?" VO__AMICIA__CH4__CHATTER_RATS_IN_HORSE_001__M__1
TT 3383 "Yo'q! Kalamushlar! Ulardan uzoqroq turing!" VO__AMICIA__CH4__CHATTER_RATS_IN_HORSE_003__M__1
TT 3384 "Bu yordam berishi kerak..." VO__AMICIA__CH4__CHATTER_RELEASE_TREBUCHET_002__M__1
TT 3385 "Bu yo'ldan, qani!" VO__AMICIA__CH4__CHATTER_REMORSE_002__M__1
TT 3386 "ENDI! Yugur!" VO__AMICIA__CH4__CHATTER_RUN_LIKE_HELL__M__1
TT 3387 "Sekinlashma, Hyugo! Melining ortidan bor!" VO__AMICIA__CH4__CHATTER_RUNNING_AWAY_1_006__M__1
TT 3388 "Hech narsa! Biz hech narsa qilmadik! Ularga Hyugo kerak!" VO__AMICIA__CH4__CHATTER_RUNNING_AWAY_1_008__M__1
TT 3389 "Ingliz qalqoni... Buni qayerdan topding?" VO__AMICIA__CH4__CHATTER_SHIELD_002__M__1
TT 3390 "Eshit, Hyugo... Uni joyiga qo'y. Bu bolalar uchun emas..." VO__AMICIA__CH4__CHATTER_SHIELD_004__M__1
TT 3391 "Oh, juda badbo'y ekan..." VO__AMICIA__CH4__CHATTER_SHIELD_009__M__1
TT 3392 "Ular... ustida mashq qilishyapti..." VO__AMICIA__CH4__CHATTER_SHOOTING_FIELD_001__M__1
TT 3393 "Ah..." VO__AMICIA__CH4__CHATTER_SHOOTING_FIELD_003__M__1
TT 3394 "Butunlay. Qochib yurishdan charchadim..." VO__AMICIA__CH4__CHATTER_SLING_IS_BACK_002__M__1
TT 3395 "G'alati... Bu nima o'zi?" VO__AMICIA__CH4__CHATTER_SMELL_REMINDER_001__M__1
TT 3396 "Askar!" VO__AMICIA__CH4__CHATTER_SOLDIER_ALERT__M__1
