TT 8579 "U otangnikimidi?" VO__LUCAS__CH9__CHATTER_INTERACT_ARTIFACT_001__M__1
TT 8580 "Unday bo'lsa u unutilmaydi." VO__LUCAS__CH9__CHATTER_INTERACT_ARTIFACT_003__M__1
