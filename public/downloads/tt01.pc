TT 2328 "Oxir-oqibat seni baribir topamiz. Ertami-kechmi..." VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ALONE__M__2
TT 2329 "Ertami kechmi seni topaman. Ertami kechmi..." VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ALONE__M__3
TT 2330 "Men seni topaman. Bunga ishonaver!" VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ALONE__M__4
TT 2331 "Qarab kelaman!" VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ANSWER__M__1
TT 2332 "U yoqni qidirish vaqti keldi!" VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ANSWER__M__2
TT 2333 "Ular shu yerda bo'lishi mumkin..." VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ANSWER__M__3
TT 2334 "Men bu yoqni qidiraman!" VO__ALCHEMIST2__GENERIC__PATROL_SEARCH_ANSWER__M__4
