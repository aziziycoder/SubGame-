rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: games
    // Document ID: gameId (or gameSlug)
    // Fields: id, title, slug, description, posterUrl, heroBanner, downloadUrl, releaseYear, etc.
    //
    // Collection: users
    // Document ID: userId (Firebase Auth UID)
    // Fields: uid, email, displayName, photoURL, lastLoginAt, createdAt
    //
    // Collection: device_sessions
    // Document ID: sessionId (e.g. 6-digit pairing code)
    // Fields: status ('pending' | 'approved'), userData, createdAt, deviceId, etc.
    //
    // Collection: licenses
    // Document ID: licenseId (e.g. {userId}_{gameId})
    // Fields: id, userId, userEmail, userName, userPhoto, gameId, gameTitle, gameSlug,
    //         status ('active' | 'revoked'), hwid, boundAt, boundDeviceName, createdAt
    //
    // Collection: issues
    // Document ID: issueId
    // Fields: title, description, userEmail, createdAt, etc.
    //
    // Collection: sliders
    // Document ID: sliderId (e.g. string slug or auto-id)
    // Fields: id, slug, title, badge, headlinePrefix, headlineHighlight, headlineSuffix,
    //         description, bgImage, cardImage, cardTag, highlightTag, version, cardDescription,
    //         order, isActive, createdAt, updatedAt
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        'email' in request.auth.token &&
        request.auth.token.email == 'azizbekgulomovweb@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Games catalog: Public read for web visitors and launcher; write only for Admin
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hero sliders: Public read for web visitors; write only for Admin
    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: Users can read/write their own profile; Admin can read and write all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // Device pairing sessions: Enables unauthenticated Electron launcher to initiate pairing
    // and authenticated web client to approve and bind account credentials
    match /device_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Game licenses:
    // Read: Open to allow desktop launcher unauthenticated check for HWID binding and activation
    // Create/Update: Open to allow desktop launcher and web users to claim licenses and bind hardware ID
    // Delete: Admin only
    match /licenses/{licenseId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Issue reports / suggestions
    match /issues/{issueId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}
