rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: games
    // Document ID: gameId (or gameSlug)
    // Fields: id, title, slug, description, posterUrl, heroBanner, downloadUrl, releaseYear, etc.
    //
    // Collection: users
    // Document ID: userId (Firebase Auth UID)
    // Fields: uid, email, displayName, photoURL, lastLoginAt, createdAt
    //
    // Collection: device_sessions
    // Document ID: sessionId (e.g. 6-digit pairing code)
    // Fields: status ('pending' | 'approved'), userData, createdAt, deviceId, etc.
    //
    // Collection: licenses
    // Document ID: licenseId (e.g. {userId}_{gameId})
    // Fields: id, userId, userEmail, userName, userPhoto, gameId, gameTitle, gameSlug,
    //         status ('active' | 'revoked'), hwid, boundAt, boundDeviceName, createdAt
    //
    // Collection: issues
    // Document ID: issueId
    // Fields: title, description, userEmail, createdAt, etc.
    //
    // Collection: sliders
    // Document ID: sliderId (e.g. string slug or auto-id)
    // Fields: id, slug, title, badge, headlinePrefix, headlineHighlight, headlineSuffix,
    //         description, bgImage, cardImage, cardTag, highlightTag, version, cardDescription,
    //         order, isActive, createdAt, updatedAt
    //
    // Collection: orders
    // Document ID: orderId (e.g. ORD_{timestamp}_{userIdPrefix}_{gameIdPrefix})
    // Fields: orderId, userId, userEmail, gameId, gameTitle, gameSlug, amount,
    //         currency, status ('pending' | 'paid' | 'failed' | 'canceled'),
    //         paymentProvider, createdAt
    //
    // ===============================================================

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token && request.auth.token.email == 'azizbekgulomovweb@gmail.com') ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
            ('isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
          )
        )
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Games catalog: Public read for web visitors and launcher; write only for Admin
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Hero sliders: Public read for web visitors; write only for Admin
    match /sliders/{sliderId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles: Users can read/write their own profile; Admin can read and write all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'user') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin'])
      );
      allow delete: if isAdmin();
    }

    // Device pairing sessions: Enables unauthenticated Electron launcher to initiate pairing
    // and authenticated web client to approve and bind account credentials
    match /device_sessions/{sessionId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Game licenses:
    // Read: Open to allow desktop launcher unauthenticated check for HWID binding and activation
    // Create/Update: Open to allow desktop launcher and web users to claim licenses and bind hardware ID
    // Delete: Admin only
    match /licenses/{licenseId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Issue reports / suggestions
    match /issues/{issueId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // Orders collection:
    // Read: Single-document get is publicly allowed so Serverless payment webhooks (Click REST API)
    //       and post-redirect checkout screens can fetch and verify order details without an auth token.
    //       List queries are restricted to the order owner or admin to prevent user/order enumeration.
    // Create: Authenticated users can create orders for themselves with 'pending' status; Admins can create all.
    // Update: Admins can update all fields; Webhooks and clients can update status ('prepared', 'paid', 'cancelled')
    //         and transaction metadata while keeping immutable fields (orderId, userId, gameId, amount, createdAt) intact.
    // Delete: Admin only.
    match /orders/{orderId} {
      allow get: if true;
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending'
      );
      allow update: if isAdmin() || (
        request.resource.data.status in ['prepared', 'paid', 'cancelled'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'clickTransId', 'clickPaydocId', 'paidAmount', 'errorNote', 'updatedAt'
        ]) &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.amount == resource.data.amount &&
        request.resource.data.gameId == resource.data.gameId &&
        (!('orderId' in request.resource.data) || request.resource.data.orderId == resource.data.orderId) &&
        (!('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt)
      );
      allow delete: if isAdmin();
    }
  }
}
